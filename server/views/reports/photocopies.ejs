<%- include('../partials/header', {title: 'כמויות צילומים', wide: true}) %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <h1>🖨️ כמויות צילומים - <%= schoolYear %></h1>
    <a href="/reports/photocopies/export" class="btn secondary">📊 ייצוא לאקסל</a>
  </div>

  <p style="color:var(--muted); font-size:0.9em; line-height:1.6;">
    מספר הילדים נמשך אוטומטית מהמערכת. "תוספת ידנית" מאפשרת להוסיף עותקים נוספים לכיתה (למשל למלמד/עוזר).
    מספר הצילומים = ילדים + תוספת. מספר "בעמוד 2" מחושב אוטומטית (חצי ממספר הצילומים, מעוגל כלפי מעלה למספר זוגי).
  </p>

  <% if (saved) { %>
    <div style="background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; border-radius:8px; padding:8px 14px; margin-bottom:12px;">✅ נשמר בהצלחה.</div>
  <% } %>

  <form method="POST" action="/reports/photocopies/save">
    <% Object.keys(grouped).forEach(branch => { %>
      <h3 style="margin-top:20px;">🏫 <%= branch %></h3>
      <table>
        <thead>
          <tr><th>הכיתה</th><th>מס' הילדים</th><th>תוספת ידנית</th><th>מס' הצילומים</th><th>מס' בעמוד 2</th></tr>
        </thead>
        <tbody>
          <% let branchTotal = 0; %>
          <% grouped[branch].forEach(c => { branchTotal += c.copies; %>
            <tr>
              <td><%= c.name %><%= c.parallel ? ' ' + c.parallel : '' %></td>
              <td><%= c.student_count %></td>
              <td><input type="number" name="extra_<%= c.id %>" value="<%= c.extra %>" style="width:70px;" /></td>
              <td class="calc-copies" style="font-weight:700;"><%= c.copies %></td>
              <td><%= c.page2 %></td>
            </tr>
          <% }) %>
          <tr style="background:#fff3c4; font-weight:700;">
            <td colspan="3">סה"כ צילומים</td>
            <td colspan="2"><%= branchTotal %></td>
          </tr>
        </tbody>
      </table>
    <% }) %>

    <div class="actions" style="margin-top:16px; position:sticky; bottom:0; background:#fff; padding:10px 0;">
      <button type="submit" class="btn">💾 שמירת התוספות</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
