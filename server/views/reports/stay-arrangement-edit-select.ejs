<%- include('../partials/header', {title: 'מילוי הסדר השארה'}) %>

<div class="card">
  <h1>📋 מילוי הסדר השארה</h1>
  <p style="color:var(--muted); font-size:0.9em; line-height:1.6;">
    רלוונטי לכיתות מכינה א', מכינה ב' וכיתה א' - בוחרים כיתה, ממלאים עבור כל תלמיד האם מעוניין ובאיזה סכום,
    ואפשר אחר כך להפיק דוח מודפס עם הנתונים שמולאו.
  </p>

  <% if (totalCount === 0) { %>
    <p style="color:var(--muted);">אין כיתות רלוונטיות (מכינה א'/ב' או כיתה א') פעילות במערכת.</p>
  <% } else { %>

    <%# בחירת סניף. מוצג רק כשיש יותר מסניף אחד - אחרת התפריט מיותר.
        משתמש ב-form.auto-filter, כמו שאר הסינונים במערכת: בחירה ב-select
        מגישה את הטופס מיד, בלי כפתור נפרד. %>
    <% if (branches.length > 1) { %>
      <form class="searchbar auto-filter" method="GET" action="/reports/stay-arrangement/edit">
        <select name="branch" aria-label="סינון לפי סניף">
          <option value="">כל הסניפים</option>
          <% branches.forEach(b => { %>
            <option value="<%= b %>" <%= branch === b ? 'selected' : '' %>><%= b %></option>
          <% }) %>
        </select>
        <noscript><button type="submit" class="btn small">סנן</button></noscript>
      </form>
    <% } %>

    <% if (classes.length === 0) { %>
      <p style="color:var(--muted);">
        אין כיתות רלוונטיות בסניף <%= branch %>.
        <a href="/reports/stay-arrangement/edit">הצג את כל הסניפים</a>
      </p>
    <% } else { %>
    <table>
      <thead><tr><th>כיתה</th><th>סניף</th><th></th></tr></thead>
      <tbody>
        <% classes.forEach(c => { %>
          <tr>
            <td><%= c.name %><%= c.parallel ? ' ' + c.parallel : '' %></td>
            <td><%= c.branch || '' %></td>
            <td><a href="/reports/stay-arrangement/edit/<%= c.id %>" class="btn small">מילוי</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  <% } %>

  <div class="actions" style="margin-top:16px;">
    <a href="/reports" class="btn secondary">חזרה לדוחות</a>
  </div>
</div>

<%- include('../partials/footer') %>
