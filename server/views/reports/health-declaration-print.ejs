<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>הצהרת בריאות</title>
  <style>
    @page {
      size: A4;
      margin: 10mm 14mm;
    }
    * { box-sizing: border-box; }
    body {
      font-family: "Segoe UI", "Arial Hebrew", Arial, sans-serif;
      direction: rtl;
      margin: 0;
      color: #1a1a1a;
      /* נקודות ולא פיקסלים - הטופס נועד לנייר. הבסיס גדל בכ-15%. */
      font-size: 11pt;
    }
    .page {
      max-width: 820px;
      margin: 0 auto;
      padding: 10px 28px;
      page-break-after: always;
    }
    .page:last-child, .page:last-of-type { page-break-after: auto; }
    @media print {
      .page:last-child, .page:last-of-type { page-break-after: avoid; break-after: avoid-page; }
      .page { overflow: hidden; }
    }

    .form-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2.5px solid #2c5f7c;
      padding-bottom: 6px;
      margin-bottom: 8px;
    }
    .form-header img { height: 52px; }
    .form-header .school-info { text-align: left; font-size: 0.8em; color: #555; line-height: 1.4; }
    .bsd { text-align: right; font-size: 0.8em; color: #888; }
    /* קוד הזיהוי: קטן ולא מפריע, אך גדול מספיק כדי להיקרא בסריקה רגילה.
       ממוקם בכותרת - אזור שההורים אינם כותבים בו. */
    .form-qr { text-align: center; line-height: 0; }
    .form-qr svg { width: 19mm; height: 19mm; display: block; }
    .form-qr-label { font-size: 5.5pt; color: #777; line-height: 1.2; margin-top: 1px; white-space: nowrap; }

    h2.form-title { text-align: center; margin: 6px 0 3px; font-size: 1.5em; text-decoration: underline; }
    h3.form-subtitle { text-align: center; margin: 0 0 8px; font-size: 0.95em; font-weight: 600; text-decoration: underline; }
    .school-line { text-align: center; font-size: 0.82em; margin-bottom: 8px; }

    table.fields { width: 100%; border-collapse: collapse; margin-bottom: 8px; font-size: 1em; table-layout: fixed; }
    /* גובה שורה נדיב - ההורים כותבים בין השורות */
    table.fields td { padding: 6px 6px 2px; vertical-align: bottom; line-height: 1.3; height: 26px; }
    table.fields td.label { color: #555; font-size: 0.88em; white-space: nowrap; width: 15%; text-align: right; padding-inline-end: 2px; }
    table.fields td.value { border-bottom: 1.5pt solid #333; width: 35%; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .section-title { font-weight: 800; margin: 13px 0 6px; text-decoration: underline; font-size: 1.05em; color: #1d4257; }

    .declaration { font-size: 0.92em; line-height: 1.6; }
    .declaration .row { margin-bottom: 7px; }
    .declaration .sub-row { margin-right: 22px; }
    .checkbox { display: inline-block; width: 1.2em; }
    /* ריבוע מצויר ולא התו <span class="cb"></span>: התו מוצג שונה בכל מדפסת ולעתים לא מודפס כלל. */
    .cb { display: inline-block; width: 3.6mm; height: 3.6mm; border: 1.2pt solid #222;
          margin-inline-end: 3px; vertical-align: -0.4mm; position: relative; }
    /* סימון "מסומן" מצויר בקווים ולא בתו, מאותה סיבה: תו ☑ אינו קיים בכל גופן */
    .cb-on::before, .cb-on::after {
      content: ""; position: absolute; inset: 0.5mm; border-top: 1.2pt solid #222;
    }
    .cb-on::before { transform: rotate(45deg); }
    .cb-on::after  { transform: rotate(-45deg); }
    .free-text { border-bottom: 1.2pt solid #444; padding: 0 5px; font-weight: 600; display: inline-block; min-width: 120px; }
    .free-line { border-bottom: 1.2pt solid #444; display: block; height: 1.9em; margin: 5px 0; }

    .sign-row {
      display: flex; justify-content: space-between; margin-top: 14px; font-size: 0.8em;
    }
    .sign-row div { width: 30%; text-align: center; }
    .sign-line { border-top: 1.2px solid #444; margin-top: 20px; padding-top: 4px; }

    .parent-approval {
      margin-top: 14px; padding-top: 8px; border-top: 2px solid #2c5f7c;
    }
    .approval-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 0.8em; }
    .approval-table th, .approval-table td { border: 1.2px solid #888; padding: 9px 8px; text-align: center; }

    @media print {
      .page { padding: 6px 22px; }
    }

    /* עמוד 1 - יותר רווח בין השורות, כדי שהתוכן יתפרש על פני אורך העמוד */
    .page-one .form-header { margin-bottom: 10px; padding-bottom: 8px; }
    .page-one .school-line { margin-bottom: 10px; }
    .page-one table.fields { margin-bottom: 8px; }
    .page-one table.fields td { padding: 3px 6px; line-height: 1.3; }
    .page-one .section-title { margin: 13px 0 6px; }
    .page-one .declaration { line-height: 1.7; }
    .page-one .declaration .row { margin-bottom: 7px; }
    .page-one .declaration .sub-row { margin-bottom: 7px; }
    .page-one .free-line { height: 1.4em; margin: 5px 0; }
  </style>
</head>
<body onload="window.print()">
  <% students.forEach(s => { %>

  <!-- ===== עמוד 1: פרטים מזהים + הצהרת בריאות מלאה ===== -->
  <div class="page page-one">
    <div class="form-header">
      <img src="/images/logo-reports.jpg" alt="לוגו" />
      <%# קוד זיהוי לסריקה: מזהה תלמיד, שנה ומספר עמוד. מאפשר לשייך כל
          עמוד סרוק לתלמיד הנכון בוודאות, בלי זיהוי טקסט ובלי ניחוש. %>
      <div class="form-qr">
        <%- qrs[s.id][1] %>
        <div class="form-qr-label">קוד זיהוי — נא לא לכסות</div>
      </div>
      <div class="school-info">
        תלמוד תורה החדש (יסוד העולם)<br />
        כתובת: סוקולוב 5, בני ברק<br />
        טל: 03-6185020 | פקס: 03-6185030
      </div>
    </div>
    <div class="bsd">בס"ד</div>

    <h2 class="form-title">טופס הצהרת ההורים</h2>
    <h3 class="form-subtitle">על מצב בריאותו של ילדם הלומד בתלמוד תורה</h3>
    <div class="school-line">שם התלמוד תורה: <strong>תלמוד תורה החדש (יסוד העולם)</strong> &nbsp; הישוב: <strong>בני ברק</strong></div>

    <table class="fields">
      <colgroup>
        <col style="width:15%"><col style="width:35%">
        <col style="width:15%"><col style="width:35%">
      </colgroup>
      <tr>
        <td class="label">פרטי התלמיד:</td>
        <td class="value" colspan="3"><%= s.first_name %> <%= s.last_name %></td>
      </tr>
      <tr>
        <td class="label">מס' ת"ז</td><td class="value"><%= s.id_number || '' %></td>
        <td class="label">שם חיבה</td><td class="value"><%= s.nickname || '' %></td>
      </tr>
      <tr>
        <td class="label">כיתה</td>
        <td class="value"><%= s.class_name ? s.class_name + (s.class_parallel ? ' ('+s.class_parallel+')' : '') : '' %></td>
        <td class="label">קופ"ח</td><td class="value"><%= s.health_fund || '' %></td>
      </tr>
      <tr>
        <td class="label">ת. לידה עברי</td><td class="value"><%= s.birth_date_hebrew_str || '' %></td>
        <td class="label">ת. לידה לועזי</td><td class="value"><%= s.birth_date_civil_str || '' %></td>
      </tr>
      <tr>
        <td class="label">ארץ הלידה</td><td class="value"><%= s.birth_country || 'ישראל' %></td>
        <td class="label">שנת העלייה</td><td class="value"><%= s.birth_country !== 'ישראל' ? (s.immigration_year || '') : '—' %></td>
      </tr>
      <tr>
        <td class="label">מס' ילדים במשפחה</td><td class="value" colspan="3"><%= s.siblings_count || '' %></td>
      </tr>
      <tr>
        <td class="label">הכתובת</td><td class="value" colspan="3"><%= s.address || '' %></td>
      </tr>
      <tr>
        <td class="label">טלפון בבית</td><td class="value" colspan="3"><%= s.home_phone || '' %></td>
      </tr>
      <tr>
        <td class="label">שם האב</td><td class="value"><%= s.father_name || '' %></td>
        <td class="label">מקום לימוד האב</td><td class="value"><%= s.father_workplace || '' %></td>
      </tr>
      <tr>
        <td class="label">נייד האב</td><td class="value"><%= s.father_mobile || '' %></td>
        <td class="label">מקום תפילה האב</td><td class="value"><%= s.father_synagogue || '' %></td>
      </tr>
      <tr>
        <td class="label">שם האם</td><td class="value"><%= s.mother_name || '' %></td>
        <td class="label">מקום עבודת האם</td><td class="value"><%= s.mother_workplace || '' %></td>
      </tr>
      <tr>
        <td class="label">נייד האם</td><td class="value"><%= s.mother_mobile || '' %></td>
        <td class="label">טלפון בעבודה</td><td class="value"><%= s.mother_work_phone || '' %></td>
      </tr>
      <tr>
        <td class="label">אימייל האב</td><td class="value"><%= s.father_email || '' %></td>
        <td class="label">אימייל האם</td><td class="value"><%= s.mother_email || '' %></td>
      </tr>
      <tr>
        <td class="label" colspan="4">שם, הכתובת ומספר הטלפון לפנייה בשעת מצוקה כשאחד מן ההורים לא זמין:</td>
      </tr>
      <tr>
        <td class="value" colspan="4">
          <%= s.emergency_contact ? `${s.emergency_contact.contact_name || ''} (${s.emergency_contact.relation || ''}) — ${[s.emergency_contact.phone1, s.emergency_contact.phone2].filter(Boolean).join(' / ')}` : '' %>
        </td>
      </tr>
    </table>

    <div class="section-title">הריני מצהיר/ה כי (סמן את האפשרות הנכונה):</div>
    <div class="declaration">
      <div class="row">
        <span class="checkbox"><%= s.hasHealthIssue ? '<span class="cb"></span>' : '<span class="cb cb-on"></span>' %></span>
        לא ידוע לי על מגבלות בריאותיות המונעות מבני להשתתף בפעילויות הנערכות בת"ת ומטעמו.
      </div>
      <div class="row">
        <span class="cb"></span>
        יש לבני מגבלות בריאותיות המונעות השתתפות מלאה/חלקית בפעילות בת"ת ומטעמו, כדלקמן:
        &nbsp;<span class="cb"></span> פעילות גופנית &nbsp; <span class="cb"></span> הליכה לגינות &nbsp; <span class="cb"></span> אחר: <span class="free-text">&nbsp;</span>
      </div>
      <div class="row sub-row">תיאור המגבלה: <span class="free-text" style="min-width:320px;">&nbsp;</span></div>
      <div class="row sub-row">מצורף אישור רפואי שניתן על-ידי: <span class="free-text">&nbsp;</span> לתקופה: <span class="free-text">&nbsp;</span></div>

      <div class="row" style="margin-top:8px;">
        <span class="cb"></span> לא &nbsp; <span class="cb"></span> כן —
        יש לבני בעיה בריאותית כרונית (אסטמה, סוכרת נעורים, אפילפסיה, רגישות למזון, מחלה ממארת וכד'). פרט:
        <span class="free-text">&nbsp;</span>
      </div>

      <div class="row">
        <span class="cb<%= (s.medications && s.medications !== 'לא ידוע') ? ' cb-on' : '' %>"></span> לא &nbsp;
        <span class="cb<%= (s.medications && s.medications !== 'לא ידוע') ? ' cb-on' : '' %>"></span> כן —
        בני נוטל תרופה/ות באופן קבוע. פרט:
        <span class="free-text"><%= (s.medications && s.medications !== 'לא ידוע') ? s.medications : '' %></span>
      </div>

      <div class="row">
        <span class="cb<%= (s.allergies && s.allergies !== 'לא ידוע') ? ' cb-on' : '' %>"></span>
        בני סובל מרגישות לתרופות או למזון. פרט:
        <span class="free-text"><%= (s.allergies && s.allergies !== 'לא ידוע') ? s.allergies : '' %></span>
      </div>
      <div class="row sub-row">מצורף אישור רפואי שניתן על ידי: <span class="free-text">&nbsp;</span> לתקופה: <span class="free-text">&nbsp;</span></div>

      <div class="row" style="margin-top:8px;">
        <span class="cb"></span> הריני מתחייב/ת להודיע למנהל/מלמד על כל שינוי או הגבלה זמניים או קבועים שיחולו במצב הבריאות של בני.
      </div>
      <div class="row">
        <span class="cb"></span> הריני מאשר/ת מתן מידע רלוונטי לצוות החינוכי ו/או לצוות הבריאות בכל הקשור למצב הבריאות של בני.
      </div>
      <div class="row">להלן מידע נוסף לגבי בריאות ילדי שברצוני ליידע את הת"ת על אודותיו:</div>
      <div class="free-line"></div>
      <div class="free-line"></div>
    </div>
  </div>

  <!-- ===== עמוד 2: הצהרת חיסונים + חתימה + אישור הורים ===== -->
  <div class="page page-two">
    <div class="form-header">
      <img src="/images/logo-reports.jpg" alt="לוגו" />
      <%# קוד זיהוי לסריקה: מזהה תלמיד, שנה ומספר עמוד. מאפשר לשייך כל
          עמוד סרוק לתלמיד הנכון בוודאות, בלי זיהוי טקסט ובלי ניחוש. %>
      <div class="form-qr">
        <%- qrs[s.id][2] %>
        <div class="form-qr-label">קוד זיהוי — נא לא לכסות</div>
      </div>
      <div class="school-info">
        תלמוד תורה החדש (יסוד העולם)<br />
        כתובת: סוקולוב 5, בני ברק<br />
        טל: 03-6185020 | פקס: 03-6185030
      </div>
    </div>
    <div class="bsd">בס"ד</div>
    <div style="text-align:center; font-size:0.88em; color:#555; margin-bottom:8px;">
      המשך טופס הצהרת ההורים — <%= s.first_name %> <%= s.last_name %>
    </div>

    <div class="section-title">הצהרת חיסונים:</div>
    <div class="declaration">
      <div class="row">
        הריני מאשר/ת כי ידוע לי שבמסגרת שירותי הבריאות לתלמיד יקבל בני חיסון לפי תכנית החיסונים הנקבעת על ידי משרד הבריאות, וכן בדיקות שמיעה וראייה הנקבעות על ידי משרד הבריאות.
      </div>
      <div class="row">
        הריני מאשר/ת מתן חיסונים לבני לפי תכנית זו, אלא אם אודיע בכתב על התנגדותי להנהלת הת"ת. הריני מתחייב/ת להעביר את פנקס החיסונים כשידרש.
      </div>
      <div class="row">
        <span class="cb"></span> לא &nbsp; <span class="cb"></span> כן — לבני הייתה תגובה חריגה למתן חיסון בעבר.
      </div>
      <div class="row sub-row">אם כן, פרט לאיזה חיסון: <span class="free-text">&nbsp;</span></div>
      <div class="row sub-row">תיאור התגובה: <span class="free-text" style="min-width:300px;">&nbsp;</span></div>
    </div>

    <div class="sign-row">
      <div><div class="sign-line">התאריך</div></div>
      <div><div class="sign-line">שמות ההורים</div></div>
      <div><div class="sign-line">חתימת ההורים</div></div>
    </div>

    <div class="parent-approval">
      <div class="section-title" style="text-align:center;">אישור ההורים</div>
      <div class="declaration" style="font-size:0.85em; margin-top:8px;">
        הריני <span class="free-text" style="min-width:150px;">&nbsp;</span>
        אביו/אימו של התלמיד
        <span class="free-text" style="min-width:150px;"><%= s.first_name %> <%= s.last_name %></span>
        נ"י מאשר/ת לבני לילך לבדו אל הת"ת וכן בשובו הביתה.
        <% if (s.walks_alone) { %>
          <span style="color:#555;">(סטטוס נוכחי: <strong><%= s.walks_alone %></strong>)</span>
        <% } %>
      </div>
      <table class="approval-table">
        <thead><tr><th>תאריך</th><th>שם ההורה</th><th>חתימה</th></tr></thead>
        <tbody><tr><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr></tbody>
      </table>
    </div>
  </div>
  <% }) %>
</body>
</html>
