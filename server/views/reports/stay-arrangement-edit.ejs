<%- include('../partials/header', {title: 'מילוי הסדר השארה', wide: true}) %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <h1>📋 מילוי הסדר השארה - <%= classRow.name %><%= classRow.parallel ? ' ' + classRow.parallel : '' %></h1>
    <div style="display:flex; gap:8px;">
      <a href="/reports/single-page/view?class_id=<%= classRow.id %>&page=stay_arrangement" target="_blank" class="btn secondary">🖨️ הפקת דוח</a>
      <a href="/reports/stay-arrangement/edit" class="btn secondary">← כיתה אחרת</a>
    </div>
  </div>

  <% if (saved) { %>
    <div style="background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; border-radius:8px; padding:8px 14px; margin-bottom:12px;">✅ נשמר בהצלחה.</div>
  <% } %>

  <% if (students.length === 0) { %>
    <p style="color:var(--muted);">אין תלמידים פעילים בכיתה זו.</p>
  <% } else { %>
    <form method="POST" action="/reports/stay-arrangement/edit/<%= classRow.id %>">
      <table>
        <thead>
          <tr>
            <th>תלמיד</th>
            <th colspan="2">הסדר עד פסח (200 ₪)</th>
            <th colspan="2">הסדר אחרי פסח (100 ₪)</th>
          </tr>
          <tr>
            <th></th>
            <th>מעוניין</th><th>סכום ששולם</th>
            <th>מעוניין</th><th>סכום ששולם</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(s => { %>
            <tr>
              <td>
                <input type="hidden" name="student_id" value="<%= s.id %>" />
                <%= s.family_last_name || '' %> <%= s.nickname || s.first_name || '' %>
              </td>
              <td>
                <select name="passover_interested">
                  <option value="" <%= !s.passover_interested ? 'selected' : '' %>>--</option>
                  <option value="כן" <%= s.passover_interested === 'כן' ? 'selected' : '' %>>כן</option>
                  <option value="לא" <%= s.passover_interested === 'לא' ? 'selected' : '' %>>לא</option>
                </select>
              </td>
              <td><input type="number" step="0.01" name="passover_amount" value="<%= s.passover_amount != null ? s.passover_amount : '' %>" style="width:80px;" /></td>
              <td>
                <select name="summer_interested">
                  <option value="" <%= !s.summer_interested ? 'selected' : '' %>>--</option>
                  <option value="כן" <%= s.summer_interested === 'כן' ? 'selected' : '' %>>כן</option>
                  <option value="לא" <%= s.summer_interested === 'לא' ? 'selected' : '' %>>לא</option>
                </select>
              </td>
              <td><input type="number" step="0.01" name="summer_amount" value="<%= s.summer_amount != null ? s.summer_amount : '' %>" style="width:80px;" /></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="actions" style="margin-top:16px; position:sticky; bottom:0; background:#fff; padding:10px 0;">
        <button type="submit" class="btn">💾 שמירת הכל</button>
      </div>
    </form>
  <% } %>
</div>

<%- include('../partials/footer') %>
