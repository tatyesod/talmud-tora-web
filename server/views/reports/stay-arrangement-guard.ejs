<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>רשימת הסדר השארה - שומר</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body { font-family: "FrankRuehl", "FrankRuehlCLM", "Guttman Mantova", Arial, sans-serif; direction: rtl; }
    /* לנדסקייפ - כדי שכל שורה תיכנס בשורה אחת בלי גלישה.
       הקבוע AVAILABLE_HEIGHT_MM ב-reports.js הותאם ל-175 בהתאם. */
    @page { size: A4 landscape; margin: 13mm; }
    @media print { .no-print { display: none !important; } }

    .no-print {
      background: #2c5f7c; color: #fff; padding: 10px 16px;
      display: flex; gap: 14px; align-items: center; font-size: 13px;
    }
    .no-print button { background:#fff; color:#2c5f7c; border:none; border-radius:6px; padding:6px 14px; cursor:pointer; font-weight:700; }
    .no-print a { color:#fff; }

    .title { text-align: center; font-weight: 800; font-size: 14pt; color: #2c5f7c; margin-bottom: 4px; }
    .subtitle { text-align: center; font-size: 11pt; color: #555; margin-bottom: 10px; }

    table.gd { width: 100%; border-collapse: collapse; font-size: <%= bodyFontPt %>pt; }
    /* white-space: nowrap - כל תא בשורה אחת. הגופן כבר מחושב בשרת כך
       שהשורה הרחבה ביותר בנתונים תיכנס ברוחב העמוד. */
    table.gd th, table.gd td {
      border: 0.6pt solid #999; padding: 2px 5px; text-align: center;
      height: <%= rowHeightMM %>mm; white-space: nowrap;
    }
    table.gd th { background: #dde8f0; font-weight: 700; }
    table.gd td.name-col { text-align: right; }
    tbody tr:nth-child(even) td { background: #f0f0f0; }
  </style>
</head>
<body>

<div class="no-print">
  <button onclick="window.print()">🖨️ שמירה כ-PDF / הדפסה</button>
  <span><%= students.length %> תלמידים - סניף <%= branch %></span>
  <a href="javascript:history.back()">← חזרה</a>
</div>

<div class="title">רשימת הסדר השארה - לשומר</div>
<div class="subtitle">סניף <%= branch %></div>

<table class="gd">
  <thead>
    <tr>
      <th>שם</th>
      <th>כיתה</th>
      <th>הסדר</th>
      <th>כתובת</th>
      <th>טלפון בבית</th>
      <th>נייד אב</th>
      <th>נייד אם</th>
    </tr>
  </thead>
  <tbody>
    <% students.forEach(s => { %>
      <tr>
        <td class="name-col"><%= s.family_last_name || '' %> <%= s.nickname || s.first_name || '' %></td>
        <td><%= s.className %></td>
        <td><%= s.arrangements %></td>
        <td><%= s.address %></td>
        <td><%= s.home_phone || '' %></td>
        <td><%= s.father_mobile || '' %></td>
        <td><%= s.mother_mobile || '' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

</body>
</html>
