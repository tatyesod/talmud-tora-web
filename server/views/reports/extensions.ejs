<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>רשימת שלוחות</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, 'Arial Hebrew', sans-serif; direction: rtl; }
    @page { size: A4 portrait; margin: 8mm; }
    @media print { .no-print { display: none !important; } }

    .no-print {
      background: #2c5f7c; color: #fff; padding: 10px 16px;
      display: flex; gap: 14px; align-items: center; font-size: 13px;
    }
    .no-print button { background:#fff; color:#2c5f7c; border:none; border-radius:6px; padding:6px 14px; cursor:pointer; font-weight:700; }
    .no-print a { color:#fff; }

    /* שני עותקים זהים זה לצד זה - כדי שיוצא 2 בעמוד A4 (חוצים/מקפלים
       ומקבלים שני עותקים נפרדים לתלייה בשני מקומות) */
    .copies-row { display: flex; gap: 4mm; }
    .copy { flex: 1; min-width: 0; border-left: 0.5pt dashed #bbb; padding-right: 3mm; }
    .copy:first-child { border-left: none; padding-right: 0; padding-left: 3mm; }

    .bsd { text-align: right; font-size: 8pt; margin-bottom: 2px; }
    .title { text-align: center; font-weight: 800; font-size: 12pt; color: #2c5f7c; margin-bottom: 8px; }

    table.ext { width: 100%; border-collapse: collapse; font-size: <%= bodyFontPt %>pt; }
    table.ext th, table.ext td { border: 0.6pt solid #999; padding: 1px 4px; text-align: right; height: <%= rowHeightMM %>mm; }
    table.ext th { background: #dde8f0; font-weight: 700; text-align: center; }
    table.ext td.ext-num { text-align: center; font-weight: 700; font-size: <%= extFontPt %>pt; background: #f5f5f5; }
    tr.section-row td { background: #2c5f7c; color: #fff; font-weight: 700; text-align: center; padding: 2px 4px; }
  </style>
</head>
<body>

<div class="no-print">
  <button onclick="window.print()">🖨️ שמירה כ-PDF / הדפסה</button>
  <span>רשימת שלוחות - <%= items.length %> שורות (2 עותקים בעמוד)</span>
  <a href="/reports/extensions-admin">⚙️ עדכון שלוחות</a>
  <a href="javascript:history.back()">← חזרה</a>
</div>

<div class="copies-row">
  <% for (let copyIdx = 0; copyIdx < 2; copyIdx++) { %>
    <div class="copy">
      <div class="bsd">בס"ד</div>
      <div class="title">רשימת שלוחות - טלפון פנימי</div>

      <table class="ext">
        <thead>
          <tr>
            <th>כיתה / תפקיד</th>
            <th>מלמד בוקר</th>
            <th>מלמד אחה"צ</th>
            <th>שלוחה</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
            <% if (item.sectionStart) { %>
              <tr class="section-row"><td colspan="4"><%= item.sectionLabel %></td></tr>
            <% } %>
            <tr>
              <td><%= item.className %></td>
              <td><%= item.morningTeacher %></td>
              <td><%= item.afternoonTeacher %></td>
              <td class="ext-num"><%= item.extension %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

</body>
</html>
