<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <%# הכותרת מחוץ ללולאה, ולכן נגזרת מהרשימה ולא ממשתנה של כיתה בודדת %>
  <title>אלפון - <%= directories.length === 1 ? directories[0].classFullName : directories.length + " כיתות" %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "David", "DavidCLM", "Times New Roman", serif; direction: rtl; }
    @page { size: A4 portrait; margin: 13mm; }
    /* האלפון הוא תמיד עמוד אחד: אסור לשבור בתוך הטבלה, והשארית נחתכת
       במקום לייצר עמוד שני עם שתי שורות. */
    @media print {
      table.dir { page-break-inside: avoid; break-inside: avoid; }
      table.dir tr { page-break-inside: avoid; break-inside: avoid; }
      body { overflow: hidden; }
    }
    @media print { .no-print { display: none !important; } }

    .no-print {
      background: #2c5f7c; color: #fff; padding: 10px 16px;
      display: flex; gap: 14px; align-items: center; font-size: 13px;
    }
    .no-print button { background:#fff; color:#2c5f7c; border:none; border-radius:6px; padding:6px 14px; cursor:pointer; font-weight:700; }
    .no-print a { color:#fff; }

    .letter-header-img { width: 100%; height: auto; display: block; margin-bottom: 6px; }
    .dir-bsd { text-align: right; font-size: 0.8em; color: #888; margin-bottom: 10px; }

    .dir-title {
      text-align: center; font-weight: 800; font-size: 13pt; color: #2c5f7c;
      border-bottom: 1.5pt solid #2c5f7c; padding-bottom: 8px; margin-bottom: 14px;
    }

    table.dir { width: 97%; margin: 0 auto; border-collapse: collapse; }
    table.dir th, table.dir td { border: 0.6pt solid #999; text-align: right; }
    table.dir th { background: #dde8f0; font-weight: 700; text-align: center; }
    table.dir td.num { width: 7mm; text-align: center; font-weight: 700; background: #f5f5f5; }
    table.dir td.phone, table.dir th.phone-col { text-align: center; direction: ltr; }
    .dir-title .teacher-phone { font-weight: normal; }
  </style>
</head>
<body>
<%# חישוב הפרמטרים לחלוקה לעמודים - נעשה פעם אחת, מחוץ ללולאה %>
<div class="no-print">
  <button onclick="window.print()">🖨️ שמירה כ-PDF / הדפסה</button>
  <span>
    <% if (directories.length === 1) { %>
      <%= directories[0].classFullName %> — <%= directories[0].students.length %> תלמידים
    <% } else { %>
      <%= directories.length %> כיתות —
      <%= directories.reduce((n, d) => n + d.students.length, 0) %> תלמידים
    <% } %>
  </span>
  <a href="javascript:history.back()">← חזרה</a>
</div>

<%# עמוד לכל כיתה. כשהופקה כיתה אחת, זו בדיוק התוצאה הקודמת. %>
<% directories.forEach((dir, dirIdx) => { %>
  <%
     const classFullName = dir.classFullName;
     const teacherNamePart = dir.teacherNamePart;
     const teacherMobile = dir.teacherMobile;
     const students = dir.students;
     // החישוב חייב להיות כאן ולא בראש הקובץ: הגופן נגזר ממספר התלמידים,
     // ובהפקה מרוכזת לכל כיתה מספר אחר. בראש הקובץ כל הכיתות היו
     // מקבלות את הגודל של הראשונה.
     const DIR_AVAILABLE_MM = 215;
     const dirRows = students.length + 1;
     const dirRowMM = Math.min(DIR_AVAILABLE_MM / dirRows, 12);
     const dirFontPt = Math.max(7, Math.min(13, Math.round(dirRowMM * 1.55)));
     const dirHeadPt = Math.max(dirFontPt, Math.min(16, Math.round(dirRowMM * 1.9)));
     const dirPadPx = dirRowMM < 6 ? 1 : (dirRowMM < 8 ? 2 : 4);
  %>
  <div class="dir-page"<%= dirIdx < directories.length - 1 ? ' style="page-break-after:always"' : '' %>>
<img src="/images/letterhead.jpg" alt="בלנק תלמוד תורה החדש" class="letter-header-img" />
<div class="dir-bsd">בס"ד</div>

<div class="dir-title">
  <%= classFullName %><% if (teacherNamePart) { %> - <%= teacherNamePart %><% } %><% if (teacherMobile) { %> <span class="teacher-phone"><%= teacherMobile %></span><% } %>
</div>

<%# הגדלים מוזרקים כאן ולא ב-CSS הגלובלי: הם נגזרים ממספר התלמידים,
      ובהפקה מרוכזת לכל כיתה מספר אחר. %>
  <table class="dir" style="font-size:<%= dirFontPt %>pt;">
  <style>
    .dir-page:nth-of-type(<%= dirIdx + 1 %>) table.dir th,
    .dir-page:nth-of-type(<%= dirIdx + 1 %>) table.dir td { padding: <%= dirPadPx %>px 6px; }
    .dir-page:nth-of-type(<%= dirIdx + 1 %>) table.dir th { font-size: <%= dirHeadPt %>pt; }
  </style>
  <thead>
    <tr>
      <th style="width:7mm;">#</th>
      <th>משפחה</th>
      <th>פרטי</th>
      <th>כתובת</th>
      <th class="phone-col">טלפון בבית</th>
    </tr>
  </thead>
  <tbody>
    <% students.forEach((s, i) => { %>
      <tr>
        <td class="num"><%= i + 1 %></td>
        <td><%= s.family_last || '' %></td>
        <td><%= s.first_name || '' %></td>
        <td><%= [s.street, s.house_number].filter(Boolean).join(' ') %></td>
        <td class="phone"><%= s.phone || '' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
  </div>
<% }) %>
</body>
</html>
