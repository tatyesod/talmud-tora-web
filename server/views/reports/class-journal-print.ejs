<%
  const rowsCount = Math.max(students.length, 1);
  // 222 ולא 232: מרווח ביטחון. הכותרת, הכיתוב שמעל הטבלה והתחתית תופסים
  // כ-26 מ"מ, ובדף A4 עם שוליים של 13 נשארים 271 מ"מ. 232 השאיר מרווח של
  // 13 מ"מ בלבד, שנמחק ברגע שהדפדפן מוסיף שוליים משלו - ואז נוצר עמוד
  // שני ריק. 222 משאיר 23 מ"מ.
  const AVAILABLE_BODY_HEIGHT_MM = 222;
  // +1 עבור שורת הכותרת (בפורמט 7 טורים היא באותו גובה כמו שאר השורות, כדי
  // שיהיה נוח לכתוב בה - צריך לחשב אותה כחלק מהשטח הכולל, אחרת הטבלה תגלוש)
  const rowsForHeightCalc = rowsCount + 1;
  let rowHeightMM = AVAILABLE_BODY_HEIGHT_MM / rowsForHeightCalc;
  // אין רצפה מינימלית קשיחה - הכלל העליון הוא שהטבלה **לעולם** לא תגלוש לעמוד
  // הבא, גם אם זה אומר גופן קטן מאוד לכיתה גדולה מאוד. יש רק תקרה עליונה,
  // כדי שכיתה קטנה תקבל שורות גדולות ונוחות, אבל לא ענקיות מיותר על הצורך.
  rowHeightMM = Math.min(rowHeightMM, 16);
  const journalFontSize = rowHeightMM < 6.5 ? '7pt' : (rowHeightMM < 8.5 ? '7.8pt' : '8.5pt');
  // גופן שם התלמיד גדל/קטן יחד עם גובה השורה בפועל (לא קבוע יותר) - עד תקרה
  // של 16pt לכיתות קטנות, אבל מתכווץ כמה שצריך לכיתות גדולות כדי שלא לגלוש
  // יעד: גופן 13 בכל רשימות התלמידים. מתכווץ רק כשהשורה צרה מדי - אחרת
  // כיתה גדולה הייתה גולשת לעמוד שני, וזו בדיוק התקלה שתוקנה זה עתה.
  // 13pt דורש כ-7.4 מ"מ לשורה, ולכן ההקטנה נכנסת מכ-31 תלמידים ומעלה.
  const nameFontSizePt = Math.max(6, Math.min(13, Math.round(rowHeightMM * 1.9)));
  // כותרת הטבלה: 16 אם השורה מרשה, אחרת כגודל השם
  const headFontSizePt = Math.max(nameFontSizePt, Math.min(16, Math.floor(rowHeightMM * 2.2)));
  const maxNameLen = students.reduce((m, s) => Math.max(m, (s.displayName || '').length), 4);
  // רוחב עמודת השם מחושב לפי הגופן הדינמי בפועל, כדי שהשם תמיד ייכנס בשורה
  // אחת בלי גלישה או חיתוך, בכל גודל כיתה
  const nameColWidthMM = Math.min(65, Math.max(20, Math.round(maxNameLen * nameFontSizePt * 0.21) + 8));
  // שם משפחה ושם פרטי בשתי עמודות נפרדות. הרוחב הכולל נשאר זהה לקודם, כדי
  // שלא ייגרע מקום מטורי הכתיבה. שם משפחה מעט רחב יותר - הוא בדרך כלל ארוך.
  const famColWidthMM = Math.round(nameColWidthMM * 0.55);
  const givenColWidthMM = nameColWidthMM - famColWidthMM;

  // חישוב נפרד לדף "נוכחות חודשית" (grid) - לו יש כותרת של *שתי* שורות
  // (שבוע + יום), לא שורה אחת כמו שאר הפורמטים - אם משתמשים באותו rowHeightMM
  // המשותף, הטבלה הזו תמיד תהיה שורה אחת גבוהה מדי ותגלוש לעמוד הבא
  const gridRowsForHeightCalc = rowsCount + 2;
  let gridRowHeightMM = Math.min(AVAILABLE_BODY_HEIGHT_MM / gridRowsForHeightCalc, 16);
  const gridFontSizePt = Math.max(5, Math.min(9, Math.round(gridRowHeightMM * 1.1)));

  const PAGE_LABELS = { '7col': '7 טורים', '3col': '3 טורים', '2col': '2 טורים', '1col': 'דו"ח דו חודשי', general_notes: 'הערות כלליות', grid: 'נוכחות חודשית', blank: 'דף ריק' };
  const classFullName = classRow ? classRow.name + (classRow.parallel ? ' ' + classRow.parallel : '') : '';
%>
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>יומן — <%= classRow ? classRow.name + ' ' + (classRow.parallel||'') : '' %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "David", "DavidCLM", "Times New Roman", serif; direction: rtl; }

    @page { size: A4 portrait; margin: 13mm; }
    @media print { .no-print { display: none !important; } }

    .no-print {
      background: #2c5f7c; color: #fff; padding: 10px 16px;
      display: flex; gap: 14px; align-items: center; font-size: 13px;
    }
    .no-print button { background:#fff; color:#2c5f7c; border:none; border-radius:6px; padding:6px 14px; cursor:pointer; font-weight:700; }
    .no-print a { color:#fff; }

    .page { page-break-after: always; }
    /* גם last-child וגם last-of-type: אם יתווסף אי פעם אלמנט אחרי הדף
       האחרון, last-child יפסיק להתאים והמעבר הכפוי יחזור - ואיתו עמוד ריק. */
    .page:last-child, .page:last-of-type { page-break-after: auto; }
    /* min-height נועד רק כדי שהדף ייראה מלא על המסך. בהדפסה הוא מסוכן:
       260 מ"מ ועוד כותרת ותחתית עלולים לעבור את שטח ההדפסה בפועל (271 מ"מ
       בשוליים של 13, ופחות מכך אם הדפדפן מוסיף שוליים משלו) - וחריגה של
       מילימטר אחד יוצרת עמוד שני ריק. */
    @media screen { .page { min-height: 260mm; } }

    /* הגנה משולשת מפני עמוד ריק בסוף. כל אחת מספיקה לבדה, ויחד הן מכסות
       גם התנהגות שונה בין דפדפנים:
       1. avoid במקום auto - הוראה מפורשת לא לשבור אחרי הדף האחרון. auto רק
          "מרשה" לדפדפן להחליט, ובמקרי גבול הוא בוחר לשבור.
       2. break-after - השם המודרני של אותה תכונה; דפדפנים חדשים מעדיפים אותו.
       3. overflow: hidden - אם התוכן בכל זאת גולש במילימטר בגלל עיגול או
          שוליים שהדפדפן מוסיף, החריגה נחתכת במקום לייצר עמוד שלם ריק. */
    @media print {
      .page:last-child, .page:last-of-type {
        page-break-after: avoid;
        break-after: avoid-page;
      }
      .page { overflow: hidden; }
      html, body { height: auto; }
    }

    /* כותרת (לדפי תוכן, לא לדף השער) */
    .bsd { text-align: right; font-size: 8pt; margin-bottom: 2px; }
    .header {
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 2pt solid #333; padding-bottom: 5px; margin-bottom: 8px;
    }
    .header-right { text-align: right; font-size: 9pt; min-width: 70px; }
    .date-line { border-bottom: 1pt solid #555; display: inline-block; min-width: 45px; }
    .header-center { text-align: center; flex: 1; }
    .logo { height: 38px; }
    .class-name { font-size: 12pt; font-weight: 700; margin-top: 2px; }

    /* טבלה */
    table.journal { width: 97%; margin: 0 auto; border-collapse: collapse; font-size: 8.5pt; }
    table.journal th, table.journal td {
      border: 0.7pt solid #666; padding: 2px 4px; text-align: center;
    }
    table.journal th { background: #dde8f0; font-weight: 700; font-size: <%= headFontSizePt %>pt; text-align: center; }
    table.journal td.num { width: 7mm; font-weight: 700; background: #f5f5f5; text-align: center; }
    /* חייב להיות table.journal td.name ולא td.name: הכלל
       "table.journal th, table.journal td" שלמעלה ספציפי יותר, ולכן
       text-align:center שלו גבר והשמות יצאו ממורכזים. */
    table.journal td.name { text-align: right; padding-right: 5px; white-space: nowrap; overflow: hidden; font-size: <%= nameFontSizePt %>pt; font-weight: 700; }
    .col-narrow { width: 10mm; }

    .footer-date { font-size: 7pt; color: #888; margin-top: 6px; text-align: left; }

    /* דף שער */
    .cover-page { display: flex; flex-direction: column; align-items: center; height: 100%; text-align: center;
      padding: 26mm 20mm 20mm 20mm;
      box-sizing: border-box; position: relative; }
    .cover-frame-img { position: absolute; top: 0; right: 0; left: 0; bottom: 0; width: 100%; height: 100%; object-fit: fill; z-index: 0; }
    .cover-bsd { position: absolute; top: 10mm; right: 10mm; font-size: 9pt; z-index: 1; }
    .cover-logo { height: 170px; margin-bottom: 18px; }
    .cover-inst { font-size: 30pt; font-weight: 800; color: #2c5f7c; margin-bottom: 8px; }
    .cover-sub { font-size: 19pt; color: #555; margin-bottom: 0; }
    .cover-middle { margin-top: auto; margin-bottom: auto; }
    .cover-class { font-size: 30pt; font-weight: 800; margin-bottom: 14px; }
    .cover-teacher { font-size: 22pt; font-weight: 700; color: #333; }
    .cover-year { font-size: 11pt; color: #888; margin-top: 20px; }
  </style>
</head>
<body>

<div class="no-print">
  <button onclick="window.print()">🖨️ שמירה כ-PDF / הדפסה</button>
  <span><%= classFullName %> — <%= pages.length %> דפים: <%= pages.map(p => PAGE_LABELS[p] || p).join(', ') %> — <%= students.length %> תלמידים</span>
  <a href="javascript:history.back()">← חזרה</a>
</div>

<% if (typeof skipCover === 'undefined' || !skipCover) { %>
<!-- ===== דף שער - אחיד לכולם, רק שם כיתה ומלמד משתנים ===== -->
<div class="page cover-page">
  <img src="/images/cover-frame.png" class="cover-frame-img" alt="מסגרת" />
  <div class="cover-bsd">בס"ד</div>
  <img src="/images/logo-reports.jpg" class="cover-logo" alt="לוגו" style="position:relative; z-index:1;" />
  <div class="cover-inst" style="position:relative; z-index:1;">תלמוד תורה החדש</div>
  <div class="cover-sub" style="position:relative; z-index:1;">יומן כיתה</div>
  <div class="cover-middle" style="position:relative; z-index:1;">
    <div class="cover-class"><%= classFullName %><% if (typeof teacherRole !== 'undefined' && teacherRole) { %> (<%= teacherRole %>)<% } %></div>
    <% if (teacherName) { %><div class="cover-teacher"><%= teacherName %></div><% } %>
  </div>
  <div class="cover-year" style="position:relative; z-index:1;"><%= todayHebrewStr %></div>
</div>

<%# דף ריק אוטומטי מיד אחרי השער - כדי שבהדפסה דו-צדדית הצד האחורי של
    השער יצא ריק. זה קבוע, לא ניתן לשינוי, ולא מופיע ברשימת "דפי החוברת" -
    בדיוק כמו דף השער עצמו. %>
<div class="page"></div>
<% } %>

<% pages.forEach((fmt) => { %>
<% if (fmt === 'blank') { %>
<div class="page"></div>
<% } else { %>
<div class="page">
  <div class="bsd">בס"ד</div>
  <div class="header">
    <div class="header-right">
      <div>יום:&nbsp;<span class="date-line">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
      <div style="margin-top:3px;">תאריך:&nbsp;<span class="date-line">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
    </div>
    <div class="header-center">
      <img src="/images/logo-reports.jpg" class="logo" alt="לוגו" />
      <div class="class-name">
        <%= classFullName %>
        <% if (teacherName) { %> - <%= teacherName %><% } %>
      </div>
    </div>
    <div style="min-width:70px;"></div>
  </div>

  <% const PAGE_TITLES = { grid: 'נוכחות חודשית', '1col': 'דו"ח דו חודשי', general_notes: 'הערות כלליות' }; %>
  <% if (PAGE_TITLES[fmt]) { %>
    <div style="text-align:center; font-weight:700; font-size:11pt; margin-bottom:8px;"><%= PAGE_TITLES[fmt] %></div>
  <% } %>

  <%# === 7 טורים === %>
  <% if (fmt === '7col') { %>
    <table class="journal" style="table-layout:fixed; font-size:<%= journalFontSize %>;">
      <colgroup>
        <col style="width:7mm">
        <col style="width:<%= famColWidthMM %>mm">
        <col style="width:<%= givenColWidthMM %>mm">
        <col><col><col><col><col><col><col>
      </colgroup>
      <thead><tr style="height:<%= rowHeightMM %>mm;">
        <th>#</th>
        <th>שם משפחה</th>
        <th>שם פרטי</th>
        <th></th><th></th><th></th><th></th><th></th><th></th><th></th>
      </tr></thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= rowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name"><%= s.familyName %></td>
            <td class="name"><%= s.givenName %></td>
            <td></td><td></td><td></td>
            <td></td><td></td><td></td>
            <td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <%# === 3 טורים === %>
  <% } else if (fmt === '3col') { %>
    <table class="journal" style="table-layout:fixed; font-size:<%= journalFontSize %>;">
      <colgroup>
        <col style="width:7mm">
        <col style="width:<%= famColWidthMM %>mm">
        <col style="width:<%= givenColWidthMM %>mm">
        <col><col><col>
      </colgroup>
      <thead><tr style="height:<%= rowHeightMM %>mm;">
        <th>#</th>
        <th>שם משפחה</th>
        <th>שם פרטי</th>
        <th> </th><th> </th><th> </th>
      </tr></thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= rowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name"><%= s.familyName %></td>
            <td class="name"><%= s.givenName %></td>
            <td></td><td></td><td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <%# === 2 טורים === %>
  <% } else if (fmt === '2col') { %>
    <table class="journal" style="table-layout:fixed; font-size:<%= journalFontSize %>;">
      <colgroup>
        <col style="width:7mm">
        <col style="width:<%= famColWidthMM %>mm">
        <col style="width:<%= givenColWidthMM %>mm">
        <col><col>
      </colgroup>
      <thead><tr style="height:<%= rowHeightMM %>mm;">
        <th>#</th>
        <th>שם משפחה</th>
        <th>שם פרטי</th>
        <th> </th><th> </th>
      </tr></thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= rowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name"><%= s.familyName %></td>
            <td class="name"><%= s.givenName %></td>
            <td></td><td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <%# === טור הערות אחד === %>
  <% } else if (fmt === '1col' || fmt === 'general_notes') { %>
    <table class="journal" style="table-layout:fixed; font-size:<%= journalFontSize %>;">
      <colgroup>
        <col style="width:7mm">
        <col style="width:<%= famColWidthMM %>mm">
        <col style="width:<%= givenColWidthMM %>mm">
        <col>
      </colgroup>
      <thead><tr style="height:<%= rowHeightMM %>mm;">
        <th>#</th>
        <th>שם משפחה</th>
        <th>שם פרטי</th>
        <th>הערות</th>
      </tr></thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= rowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name"><%= s.familyName %></td>
            <td class="name"><%= s.givenName %></td>
            <td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <%# === נוכחות חודשית - 4 שבועות × 6 ימים (א'-ו', בלי שבת) === %>
  <% } else if (fmt === 'grid') { %>
    <% const DAY_LETTERS = ["א'", "ב'", "ג'", "ד'", "ה'", "ו'"]; %>
    <table class="journal" style="font-size:<%= gridFontSizePt %>pt;">
      <thead>
        <tr>
          <th style="width:7mm;" rowspan="2">#</th>
          <th style="min-width:22mm;" rowspan="2">שם משפחה</th>
          <th style="min-width:18mm;" rowspan="2">שם פרטי</th>
          <% for (let w=1; w<=4; w++) { %><th colspan="6">שבוע <%= w %></th><% } %>
        </tr>
        <tr>
          <% for (let w=1; w<=4; w++) { %>
            <% DAY_LETTERS.forEach(d => { %><th class="col-narrow"><%= d %></th><% }) %>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= gridRowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name" style="font-size:<%= gridFontSizePt %>pt;"><%= s.familyName %></td>
            <td class="name" style="font-size:<%= gridFontSizePt %>pt;"><%= s.givenName %></td>
            <% for (let d=1; d<=24; d++) { %><td class="col-narrow"></td><% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <div class="footer-date"><%= todayHebrewStr %></div>
</div>
<% } %>
<% }) %>

</body>
</html>
