<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>יומן — <%= classRow ? classRow.name + ' ' + (classRow.parallel||'') : '' %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "FrankRuehl", "FrankRuehlCLM", "Guttman Mantova", Arial, 'Arial Hebrew', sans-serif; direction: rtl; }

    @page { size: A4 portrait; margin: 13mm; }
    @media print { .no-print { display: none !important; } }

    .no-print {
      background: #2c5f7c; color: #fff; padding: 10px 16px;
      display: flex; gap: 14px; align-items: center; font-size: 13px;
    }
    .no-print button { background:#fff; color:#2c5f7c; border:none; border-radius:6px; padding:6px 14px; cursor:pointer; font-weight:700; }
    .no-print a { color:#fff; }

    .page { page-break-after: always; min-height: 260mm; }
    .page:last-child { page-break-after: auto; }

    /* כותרת (לדפי תוכן, לא לדף השער) */
    .bsd { text-align: right; font-size: 8pt; margin-bottom: 2px; }
    .header {
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 2pt solid #333; padding-bottom: 5px; margin-bottom: 8px;
    }
    .header-right { text-align: right; font-size: 9pt; min-width: 70px; }
    .date-line { border-bottom: 1pt solid #555; display: inline-block; min-width: 45px; }
    .header-center { text-align: center; flex: 1; }
    .logo { height: 38px; }
    .class-name { font-size: 12pt; font-weight: 700; margin-top: 2px; }

    /* טבלה */
    table.journal { width: 97%; margin: 0 auto; border-collapse: collapse; font-size: 8.5pt; }
    table.journal th, table.journal td {
      border: 0.7pt solid #666; padding: 2px 4px; text-align: center;
    }
    table.journal th { background: #dde8f0; font-weight: 700; font-size: 8pt; }
    td.num { width: 7mm; font-weight: 700; background: #f5f5f5; text-align: center; }
    td.name { text-align: right; padding-right: 5px; white-space: nowrap; overflow: hidden; font-size: 16pt; font-weight: 700; }
    .col-narrow { width: 10mm; }

    .footer-date { font-size: 7pt; color: #888; margin-top: 6px; text-align: left; }

    /* דף שער */
    .cover-page { display: flex; flex-direction: column; align-items: center; min-height: 260mm; text-align: center;
      padding: 26mm 20mm 20mm 20mm;
      background-image: url('/images/cover-frame.png'); background-size: 100% 100%; background-repeat: no-repeat;
      box-sizing: border-box; position: relative; }
    .cover-bsd { position: absolute; top: 10mm; right: 10mm; font-size: 9pt; }
    .cover-logo { height: 170px; margin-bottom: 18px; }
    .cover-inst { font-size: 30pt; font-weight: 800; color: #2c5f7c; margin-bottom: 8px; }
    .cover-sub { font-size: 19pt; color: #555; margin-bottom: 0; }
    .cover-middle { margin-top: auto; margin-bottom: auto; }
    .cover-class { font-size: 30pt; font-weight: 800; margin-bottom: 14px; }
    .cover-teacher { font-size: 22pt; font-weight: 700; color: #333; }
    .cover-year { font-size: 11pt; color: #888; margin-top: 20px; }
  </style>
</head>
<body>
<%
  const rowsCount = Math.max(students.length, 1);
  const AVAILABLE_BODY_HEIGHT_MM = 232;
  let rowHeightMM = AVAILABLE_BODY_HEIGHT_MM / rowsCount;
  // גובה מינימלי גדל, כי שם התלמיד תמיד ב-16pt קבוע (ראו td.name למטה) - צריך
  // מספיק גובה שורה כדי שזה יהיה קריא ולא ייחתך
  rowHeightMM = Math.max(8.5, Math.min(rowHeightMM, 16));
  const journalFontSize = rowHeightMM < 6.5 ? '7pt' : (rowHeightMM < 8.5 ? '7.8pt' : '8.5pt');
  const maxNameLen = students.reduce((m, s) => Math.max(m, (s.displayName || '').length), 4);
  // רוחב עמודת השם מחושב לפי גופן 16pt קבוע (לא לפי journalFontSize המשתנה),
  // כדי שהשם תמיד ייכנס בשורה אחת בלי גלישה או חיתוך
  const nameColWidthMM = Math.min(65, Math.max(26, Math.round(maxNameLen * 3.4) + 10));

  const PAGE_LABELS = { '7col': '7 טורים', '2col': '2 טורים', '1col': 'דו"ח דו חודשי', general_notes: 'הערות כלליות', grid: 'נוכחות חודשית', blank: 'דף ריק' };
  const classFullName = classRow ? classRow.name + (classRow.parallel ? ' ' + classRow.parallel : '') : '';
%>

<div class="no-print">
  <button onclick="window.print()">🖨️ שמירה כ-PDF / הדפסה</button>
  <span><%= classFullName %> — <%= pages.length %> דפים: <%= pages.map(p => PAGE_LABELS[p] || p).join(', ') %> — <%= students.length %> תלמידים</span>
  <a href="javascript:history.back()">← חזרה</a>
</div>

<!-- ===== דף שער - אחיד לכולם, רק שם כיתה ומלמד משתנים ===== -->
<div class="page cover-page">
  <div class="cover-bsd">בס"ד</div>
  <img src="/images/logo-reports.jpg" class="cover-logo" alt="לוגו" />
  <div class="cover-inst">תלמוד תורה החדש</div>
  <div class="cover-sub">יומן כיתה</div>
  <div class="cover-middle">
    <div class="cover-class"><%= classFullName %></div>
    <% if (teacherName) { %><div class="cover-teacher"><%= teacherName %></div><% } %>
  </div>
  <div class="cover-year"><%= todayHebrewStr %></div>
</div>

<%# דף ריק אוטומטי מיד אחרי השער - כדי שבהדפסה דו-צדדית הצד האחורי של
    השער יצא ריק. זה קבוע, לא ניתן לשינוי, ולא מופיע ברשימת "דפי החוברת" -
    בדיוק כמו דף השער עצמו. %>
<div class="page"></div>

<% pages.forEach((fmt) => { %>
<% if (fmt === 'blank') { %>
<div class="page"></div>
<% } else { %>
<div class="page">
  <div class="bsd">בס"ד</div>
  <div class="header">
    <div class="header-right">
      <div>יום:&nbsp;<span class="date-line">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
      <div style="margin-top:3px;">תאריך:&nbsp;<span class="date-line">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
    </div>
    <div class="header-center">
      <img src="/images/logo-reports.jpg" class="logo" alt="לוגו" />
      <div class="class-name">
        <%= classFullName %>
        <% if (teacherName) { %> - <%= teacherName %><% } %>
      </div>
    </div>
    <div style="min-width:70px;"></div>
  </div>

  <% const PAGE_TITLES = { grid: 'נוכחות חודשית', '1col': 'דו"ח דו חודשי', general_notes: 'הערות כלליות' }; %>
  <% if (PAGE_TITLES[fmt]) { %>
    <div style="text-align:center; font-weight:700; font-size:11pt; margin-bottom:8px;"><%= PAGE_TITLES[fmt] %></div>
  <% } %>

  <%# === 7 טורים === %>
  <% if (fmt === '7col') { %>
    <table class="journal" style="table-layout:fixed; font-size:<%= journalFontSize %>;">
      <colgroup>
        <col style="width:7mm">
        <col style="width:<%= nameColWidthMM %>mm">
        <col><col><col><col><col><col><col>
      </colgroup>
      <thead><tr style="height:<%= rowHeightMM %>mm;">
        <th>#</th>
        <th style="text-align:right; padding-right:5px;">שם התלמיד</th>
        <th></th><th></th><th></th><th></th><th></th><th></th><th></th>
      </tr></thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= rowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name"><%= s.displayName %></td>
            <td></td><td></td><td></td>
            <td></td><td></td><td></td>
            <td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <%# === 2 טורים === %>
  <% } else if (fmt === '2col') { %>
    <table class="journal" style="table-layout:fixed; font-size:<%= journalFontSize %>;">
      <colgroup>
        <col style="width:7mm">
        <col style="width:<%= nameColWidthMM %>mm">
        <col><col>
      </colgroup>
      <thead><tr style="height:<%= rowHeightMM %>mm;">
        <th>#</th>
        <th style="text-align:right; padding-right:5px;">שם התלמיד</th>
        <th> </th><th> </th>
      </tr></thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= rowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name"><%= s.displayName %></td>
            <td></td><td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <%# === טור הערות אחד === %>
  <% } else if (fmt === '1col' || fmt === 'general_notes') { %>
    <table class="journal" style="table-layout:fixed; font-size:<%= journalFontSize %>;">
      <colgroup>
        <col style="width:7mm">
        <col style="width:<%= nameColWidthMM %>mm">
        <col>
      </colgroup>
      <thead><tr style="height:<%= rowHeightMM %>mm;">
        <th>#</th>
        <th style="text-align:right; padding-right:5px;">שם התלמיד</th>
        <th>הערות</th>
      </tr></thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= rowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name"><%= s.displayName %></td>
            <td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <%# === נוכחות חודשית - 4 שבועות × 6 ימים (א'-ו', בלי שבת) === %>
  <% } else if (fmt === 'grid') { %>
    <% const DAY_LETTERS = ["א'", "ב'", "ג'", "ד'", "ה'", "ו'"]; %>
    <table class="journal" style="font-size:<%= journalFontSize %>;">
      <thead>
        <tr>
          <th style="width:7mm;" rowspan="2">#</th>
          <th style="min-width:40mm; text-align:right; padding-right:5px;" rowspan="2">שם התלמיד</th>
          <% for (let w=1; w<=4; w++) { %><th colspan="6">שבוע <%= w %></th><% } %>
        </tr>
        <tr>
          <% for (let w=1; w<=4; w++) { %>
            <% DAY_LETTERS.forEach(d => { %><th class="col-narrow"><%= d %></th><% }) %>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr style="height:<%= rowHeightMM %>mm;">
            <td class="num"><%= i+1 %></td>
            <td class="name"><%= s.displayName %></td>
            <% for (let d=1; d<=24; d++) { %><td class="col-narrow"></td><% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <div class="footer-date"><%= todayHebrewStr %></div>
</div>
<% } %>
<% }) %>

</body>
</html>
