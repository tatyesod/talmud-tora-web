<%- include('../partials/header', {title: 'היסטוריית הזמנות - ' + supplier.name, wide: true}) %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <h1>📚 היסטוריית הזמנות - <%= supplier.name %></h1>
    <a href="/suppliers/<%= supplier.id %>/order" class="btn secondary">← חזרה להזמנה</a>
  </div>

  <p style="color:var(--muted); font-size:0.9em;">
    בכל פעם שלוחצים "🔄 בצע איפוס הזמנה" במסך ההזמנה, נשמרת כאן תמונת מצב מלאה של מה שהוזמן באותו רגע - כדי שתוכלו
    תמיד לחזור ולראות מה בדיוק נשלח לספק, ולבדוק מול מה שבאמת הגיע.
  </p>

  <% if (checkpoints.length === 0) { %>
    <p class="empty-state">אין עדיין היסטוריית הזמנות - היא תיווצר בפעם הראשונה שתלחצו "בצע איפוס הזמנה".</p>
  <% } else { %>
    <table>
      <thead><tr><th>סניף</th><th>תאריך</th><th>הערה</th><th></th></tr></thead>
      <tbody>
        <% checkpoints.forEach(c => { %>
          <tr>
            <td><%= c.branch %></td>
            <td><%= toHebDate(c.created_at) %></td>
            <td><%= c.note || '' %></td>
            <td>
              <a href="/suppliers/<%= supplier.id %>/checkpoints/<%= c.id %>" class="btn small secondary">צפייה / בדיקת אספקה</a>
              <form method="POST" action="/suppliers/<%= supplier.id %>/checkpoints/<%= c.id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('למחוק את ההזמנה הזו מההיסטוריה? לא ניתן לשחזר.');">
                <button type="submit" class="btn small danger">מחק</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
