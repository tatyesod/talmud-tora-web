<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>תלמוד תורה החדש - מערכת ניהול</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" />
  <link rel="stylesheet" href="/css/home.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/images/icon-192.png" />
  <link rel="icon" href="/images/icon-192.png" />
  <meta name="theme-color" content="#0d1b2e" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="ת״ת החדש" />
</head>
<body class="home-body">

  <div class="home-bg">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="orb orb3"></div>
    <div class="stars"></div>
  </div>

  <div class="home-topbar">
    <span class="bsd">בס"ד</span>
    <a href="/year" class="year-pill">שנת לימודים: <strong><%= currentYear %></strong></a>
    <a href="/messages" class="year-pill">💬 הודעות<% if (unreadCount > 0) { %> <span class="unread-badge"><%= unreadCount %></span><% } %></a>
    <button type="button" class="year-pill" onclick="openOrFocus('calendar', 'https://calendar.google.com')" style="cursor:pointer;">📅 יומן גוגל שלי</button>
    <button type="button" class="year-pill" onclick="openOrFocus('gmail', 'https://mail.google.com/mail/u/0/#inbox')" style="cursor:pointer;">📧 ג'ימייל שלי</button>
    <% if (isAdmin) { %><a href="/users" class="year-pill">👥 משתמשים</a><% } %>
    <a href="/profile" class="year-pill">👤 <%= user %></a>
    <form action="/logout" method="POST">
      <button type="submit" class="btn-logout">יציאה</button>
    </form>
  </div>

  <main class="home-main">

    <div class="logo-wrap">
      <div class="logo-glow"></div>
      <img src="/images/logo.png" alt="תלמוד תורה החדש" class="home-logo"
           id="home-logo-img" data-retry="0" />
    </div>

    <h1 class="home-title">תלמוד תורה החדש</h1>
    <div class="home-title-divider"><span class="home-title-ornament"></span></div>
    <p class="home-subtitle">מערכת ניהול דיגיטלית</p>
    <p class="home-greeting"><span class="greeting-word"><%= greeting %>,</span> <strong><%= fullName %></strong></p>

    <div class="stats-row">
      <div class="stat-pill"><span class="stat-num"><%= stats.students %></span><span class="stat-label">תלמידים פעילים</span></div>
      <div class="stat-pill"><span class="stat-num"><%= stats.classes %></span><span class="stat-label">כיתות</span></div>
      <div class="stat-pill"><span class="stat-num"><%= stats.teachers %></span><span class="stat-label">מלמדים</span></div>
      <div class="stat-pill"><span class="stat-num"><%= stats.families %></span><span class="stat-label">משפחות</span></div>
      <%# סך גבייה חודשית הועבר לדף שכר לימוד %>
    </div>

    <div class="branch-stats-row">
      <% if (unassignedClassCount > 0) { %>
        <a href="/students?status=<%= encodeURIComponent('פעיל') %>&class_id=__none__" class="branch-pill" style="border-color: rgba(199,90,90,0.5);">
          <span class="branch-pill-count" style="background: rgba(199,90,90,0.3);"><%= unassignedClassCount %></span>
          <span class="branch-pill-name">לא משויך לכיתה</span>
        </a>
      <% } %>
      <% if (mismatchedBranchCount > 0) { %>
        <a href="/students/mismatched-branch" class="branch-pill" style="border-color: rgba(199,90,90,0.5);">
          <span class="branch-pill-count" style="background: rgba(199,90,90,0.3);"><%= mismatchedBranchCount %></span>
          <span class="branch-pill-name">⚠️ שיבוץ שגוי</span>
        </a>
      <% } %>
      <% branchStats.forEach(b => { %>
        <a href="/students?status=<%= encodeURIComponent('פעיל') %>&branch=<%= encodeURIComponent(b.branch) %>" class="branch-pill">
          <span class="branch-pill-count"><%= b.count %></span>
          <span class="branch-pill-name"><%= b.branch %></span>
        </a>
      <% }) %>
    </div>

    <% if (isAdmin && pendingOrders && pendingOrders.length > 0) { %>
      <div class="card" style="background:#fff3e0; border:1px solid #ffcc80; margin:14px auto; max-width:900px; text-align:right;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
          <h3 style="margin:0;">📦 הזמנות ממתינות לאישור (<%= pendingOrders.length %>)</h3>
          <a href="/suppliers/orders?status=<%= encodeURIComponent('ממתין לאישור') %>" class="btn small secondary">כל ההזמנות</a>
        </div>
        <table style="margin-top:10px;">
          <tbody>
            <% pendingOrders.forEach(o => { %>
              <tr>
                <td><strong><%= o.supplier_name %></strong></td>
                <td><%= o.description %></td>
                <td style="color:var(--muted); font-size:0.85em;"><%= o.creator_name || '' %></td>
                <td>
                  <form method="POST" action="/suppliers/orders/<%= o.id %>/approve" style="display:inline">
                    <button type="submit" class="btn small">✅ אישור</button>
                  </form>
                  <a href="/suppliers/orders/<%= o.id %>" class="btn small secondary">פרטים</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (myOrderUpdates && myOrderUpdates.length > 0) { %>
      <div class="card" style="background:#eef6ee; border:1px solid #bcd9bc; margin:14px auto; max-width:900px; text-align:right;">
        <h3 style="margin:0 0 10px;">📦 עדכון על ההזמנות שלך</h3>
        <table>
          <tbody>
            <% myOrderUpdates.forEach(o => { %>
              <tr>
                <td><strong><%= o.supplier_name %></strong></td>
                <td><%= o.description %></td>
                <td>
                  <% if (o.status === 'אושר') { %>
                    <span style="color:#2e7d32;">✅ אושר ע"י <%= o.approver_name || '' %></span>
                  <% } else { %>
                    <span style="color:#a94442;">❌ נדחה<%= o.rejection_reason ? ' — ' + o.rejection_reason : '' %></span>
                  <% } %>
                </td>
                <td style="white-space:nowrap;">
                  <% if (o.status === 'אושר') { %>
                    <% if (o.mailtoLink) { %><a href="<%= o.mailtoLink %>" class="btn small">📧 שליחה במייל לספק</a><% } %>
                    <form method="POST" action="/suppliers/orders/<%= o.id %>/mark-sent" style="display:inline">
                      <button type="submit" class="btn small secondary">✔️ סומן כנשלח</button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/suppliers/orders/<%= o.id %>/dismiss" style="display:inline">
                      <button type="submit" class="btn small secondary">הבנתי</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="nav-section-divider"></div>

    <%# שיחות אחרונות. מוצגות רק כשיש, ומאפשרות לראות מי התקשר גם
        אם ההתראה נעלמה או לא הופיעה. %>
    <% if (typeof recentCalls !== 'undefined' && recentCalls.length) { %>
      <div class="calls-box">
        <div class="calls-head">📞 שיחות אחרונות</div>
        <% recentCalls.slice(0, 5).forEach(c => { %>
          <div class="calls-item">
            <span class="calls-time"><%= new Date(c.created_at).toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' }) %></span>
            <% if (c.matched_title) { %>
              <a href="<%= c.target_url %>"><%= c.matched_title %></a><% if (c.matched_subtitle) { %><span class="calls-sub"> · <%= c.matched_subtitle %></span><% } %>
            <% } else { %>
              <span class="calls-unknown"><%= c.number %> — אינו מוכר</span>
            <% } %>
            <span class="calls-num"><%= c.number %></span>
          </div>
        <% }) %>
      </div>
    <% } %>

    <%# תזכורות מלוח שנת הלימודים. מוצגות רק כשיש משהו מתקרב, כדי שלא
        יהפכו לרעש שמתעלמים ממנו. %>
    <% if (typeof yearTasksDue !== 'undefined' && yearTasksDue.length) { %>
      <div class="yc-alert">
        <div class="yc-alert-head">🗓️ מתקרב בלוח השנה</div>
        <% yearTasksDue.slice(0, 4).forEach(t => { %>
          <div class="yc-alert-item">
            <strong><%= t.daysUntil === 0 ? 'היום' : 'בעוד ' + t.daysUntil + ' ימים' %></strong>
            ·
            <% if (t.link_url) { %><a href="<%= t.link_url %>"><%= t.title %></a>
            <% } else { %><%= t.title %><% } %>
            <span class="yc-alert-date"><%= t.hebrewLabel %></span>
          </div>
        <% }) %>
        <a href="/year-calendar" class="yc-alert-more">לוח שנת הלימודים ←</a>
      </div>
    <% } %>

    <div class="nav-grid" id="nav-grid">
      <%# הצהרת בריאות - קבצים סרוקים שנקלטו %>
      <% if (showCard("/year-calendar")) { %><a href="/year-calendar" class="nav-card" style="--d:1">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
        </div>
        <div class="nav-text">לוח שנת הלימודים</div>
        <div class="nav-sub">מה שולחים ומתי</div>
      </a><% } %>

      <%# ניהול שנה - היה נגיש רק מהתפריט ומשורת השנה למעלה %>
      <% if (showCard("/year")) { %><a href="/year" class="nav-card" style="--d:1">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h3"/><path d="M8 18h6"/></svg>
        </div>
        <div class="nav-text">ניהול שנה</div>
        <div class="nav-sub">העלאת שנה ומפת מעברים</div>
      </a><% } %>

      <% if (showCard("/scans")) { %><a href="/scans" class="nav-card" style="--d:1">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/></svg>
        </div>
        <div class="nav-text">הצהרת בריאות</div>
        <div class="nav-sub">קבצים סרוקים</div>
      </a><% } %>

      <% if (showCard("/reports")) { %><a href="/reports" class="nav-card" style="--d:1">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div class="nav-text">דוחות</div>
        <div class="nav-sub">ייצוא ורשימות</div>
      </a><% } %>

      <% if (showCard("/students")) { %><a href="/students" class="nav-card" style="--d:0">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="nav-text">תלמידים</div>
        <div class="nav-sub">רשימה, חיפוש, כרטיסים</div>
      </a><% } %>
      <% if (showCard("/classes")) { %><a href="/classes" class="nav-card" style="--d:1">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div class="nav-text">כיתות ומחזורים</div>
        <div class="nav-sub">שיבוצים וניהול כיתות</div>
      </a><% } %>
      <% if (showCard("/teachers")) { %><a href="/teachers" class="nav-card" style="--d:2">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/><path d="M18 14l2 2 4-4" stroke-width="1.8"/></svg>
        </div>
        <div class="nav-text">מלמדים ועובדים</div>
        <div class="nav-sub">סגל הוראה וניהול</div>
      </a><% } %>
      <% if (showCard("/families")) { %><a href="/families" class="nav-card" style="--d:3">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><circle cx="6" cy="10" r="2.5"/><circle cx="18" cy="10" r="2.5"/></svg>
        </div>
        <div class="nav-text">משפחות</div>
        <div class="nav-sub">הורים, כתובות וקשר</div>
      </a><% } %>
      <% if (showCard("/tuition")) { %><a href="/tuition" class="nav-card" style="--d:4">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="6" y1="15" x2="8" y2="15"/><line x1="10" y1="15" x2="14" y2="15"/></svg>
        </div>
        <div class="nav-text">שכר לימוד</div>
        <div class="nav-sub">תעריפים, הנחות וחישוב</div>
      </a><% } %>
      <% if (showCard("/students/new")) { %><a href="/students/new" class="nav-card" style="--d:5">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="16" y1="11" x2="22" y2="11"/></svg>
        </div>
        <div class="nav-text">קליטת תלמיד חדש</div>
        <div class="nav-sub">הוספה מהירה</div>
      </a><% } %>

      <% if (showCard("/suppliers")) { %><a href="/suppliers" class="nav-card" style="--d:7">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <div class="nav-text">ספקים והזמנות</div>
        <div class="nav-sub">פרטי קשר והזמנות</div>
      </a><% } %>

      <% if (showCard("/expenses")) { %><a href="/expenses" class="nav-card" style="--d:8">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/><line x1="12" y1="10" x2="16" y2="10"/></svg>
        </div>
        <div class="nav-text">הוצאות</div>
        <div class="nav-sub">מעקב מול ספקים</div>
      </a><% } %>

      <% if (showCard("/events")) { %><a href="/events" class="nav-card" style="--d:9; position:relative;">
        <% if (upcomingEventsCount > 0) { %>
          <span class="nav-badge-dot" title="יש אירוע מתוכנן שטרם עבר זמנו"></span>
        <% } %>
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="8" cy="15" r="1" fill="currentColor"/><circle cx="12" cy="15" r="1" fill="currentColor"/><circle cx="16" cy="15" r="1" fill="currentColor"/></svg>
        </div>
        <div class="nav-text">אירועים</div>
        <div class="nav-sub">לוח שנה והרשמות</div>
      </a><% } %>

      <% if (showCard("/inventory")) { %><a href="/inventory" class="nav-card" style="--d:10">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <div class="nav-text">מלאי ותחזוקה</div>
        <div class="nav-sub">ציוד ובקשות תיקון</div>
      </a><% } %>

      <% if (showCard("/parent-comm")) { %><a href="/parent-comm" class="nav-card" style="--d:11">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div class="nav-text">תקשורת הורים</div>
        <div class="nav-sub">מייל קבוצתי ופניות</div>
      </a><% } %>

      <% if (showCard("/books")) { %><a href="/books" class="nav-card" style="--d:12">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <div class="nav-text">הזמנת ספרים</div>
        <div class="nav-sub">ניהול הזמנות וחיובים</div>
      </a><% } %>
      <% if (showCard("/families/donations")) { %><a href="/families/donations" class="nav-card" style="--d:13">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7.5-4.8-10-9.3C.4 8.3 2 4.5 5.6 4c2-.3 3.8.7 4.4 2.3.6-1.6 2.4-2.6 4.4-2.3C18 4.5 19.6 8.3 22 11.7 19.5 16.2 12 21 12 21z"/></svg>
        </div>
        <div class="nav-text">תרומות</div>
        <div class="nav-sub">מעקב תרומות חודשיות</div>
      </a><% } %>

      <% if (showCard("/campaigns")) { %><a href="/campaigns" class="nav-card" style="--d:14">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M2 8V6a2 2 0 0 1 2-2h2"/><path d="M18 4h2a2 2 0 0 1 2 2v2"/><path d="M22 16v2a2 2 0 0 1-2 2h-2"/><path d="M6 20H4a2 2 0 0 1-2-2v-2"/></svg>
        </div>
        <div class="nav-text">מבצעים כיתתיים</div>
        <div class="nav-sub">איסוף כרטיסים ונקודות</div>
      </a><% } %>

