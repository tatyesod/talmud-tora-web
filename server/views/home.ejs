  <script>
  // פותח טאב חדש לג'ימייל/יומן, אבל אם כבר יש כזה פתוח (מלחיצה קודמת
  // באותו טעינת-דף) - קופץ אליו ישירות במקום לפתוח עוד אחד
  const externalTabs = {};
  function openOrFocus(key, url) {
    const existing = externalTabs[key];
    if (existing && !existing.closed) {
      existing.focus();
      return;
    }
    externalTabs[key] = window.open(url, '_blank');
  }
  </script>
  <script>
  // ===== גרירת כרטיסי ניווט =====
  (function() {
    const grid = document.getElementById('nav-grid');
    if (!grid) return;

      // הסדר נשמר בשרת (users.nav_order) ולכן זהה בכל מחשב שהמשתמש עובד בו
      function saveOrderToServer(order) {
        fetch('/api/nav-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ order: order })
        }).catch(function () { /* כישלון רשת - הסדר על המסך נשאר */ });
      }

      // החלת הסדר השמור לפני חישוב השהיות ההנפשה
      const savedOrder = <%- JSON.stringify(navOrder || '') %> || null;
      if (savedOrder) {
        try {
          const order = JSON.parse(savedOrder);
          const cards = [...grid.children];
          const moved = new Set();
          order.forEach(href => {
            const card = cards.find(c => c.getAttribute('href') === href);
            if (card) { grid.appendChild(card); moved.add(card); }
          });
          // כרטיס שנוסף אחרי ששמרתם סדר מותאם - מוסיפים בסוף במפורש
          cards.forEach(card => { if (!moved.has(card)) grid.appendChild(card); });
        } catch (e) { /* סדר פגום - מציגים כרגיל */ }
      }

    // הסדר המותאם והגרירה הוסרו: הכרטיסים בסדר הקבוע שבתבנית.
    // עכשיו, כשהסדר הסופי ידוע, קובעים לכל כרטיס השהיה לפי מיקומו בפועל.
    // שתי מסגרות המתנה נחוצות: בלעדיהן הדפדפן מצרף את מצב הפתיחה ואת הוספת
    // המחלקה לאותה מסגרת, ההנפשה לא מתחילה כלל, והכרטיסים פשוט "קופצים".
    // ההשהיות קוצרו: קודם החשיפה נמשכה כ-1.5 שניות, ובחלון הזה החוט הראשי
    // עסוק בהנפשת 16 כרטיסים - כל לחיצה בתוכו ממתינה. עכשיו הכל מסתיים
    // בפחות מחצי שנייה, וההשהיה בין כרטיס לכרטיס קטנה מכדי להיות מורגשת
    // כעיכוב אך מספיקה כדי שהחשיפה תיראה הדרגתית.
    const navCards = [...grid.querySelectorAll('.nav-card')];
    navCards.forEach((c, i) => { c.style.animationDelay = (0.04 + i * 0.018) + 's'; });
    requestAnimationFrame(() => requestAnimationFrame(() => {
      grid.classList.add('ordered');
      // בתום החשיפה מסירים את ההנפשה, כדי שאפקט הריחוף יחזור לעבוד כרגיל
      // ושלא יישאר שום דבר פעיל על החוט הראשי
      const totalMs = (0.04 + navCards.length * 0.018 + 0.3) * 1000;
      setTimeout(() => {
        navCards.forEach(c => { c.style.animationDelay = ''; });
        grid.classList.add('done');
      }, totalMs);
    }));


      // ===== גרירה לסידור מחדש =====
      // draggable תמידי, בלי כפתור ובלי מצב - כמו שהיה במקור.
      let dragSrc = null;
      grid.querySelectorAll('.nav-card').forEach(card => {
        card.setAttribute('draggable', 'true');
        card.style.cursor = 'grab';

        card.addEventListener('dragstart', e => {
          dragSrc = card;
          card.classList.add('dragging');
          e.dataTransfer.effectAllowed = 'move';
        });

        card.addEventListener('dragend', () => {
          card.classList.remove('dragging');
          grid.querySelectorAll('.nav-card').forEach(c => c.classList.remove('drag-over'));
          const order = [...grid.querySelectorAll('.nav-card')].map(c => c.getAttribute('href'));
          saveOrderToServer(order);
        });

        card.addEventListener('dragover', e => {
          e.preventDefault();
          if (card !== dragSrc) card.classList.add('drag-over');
        });

        card.addEventListener('dragleave', () => card.classList.remove('drag-over'));

        card.addEventListener('drop', e => {
          e.preventDefault();
          card.classList.remove('drag-over');
          if (dragSrc && dragSrc !== card) {
            const allCards = [...grid.children];
            const srcIdx = allCards.indexOf(dragSrc);
            const tgtIdx = allCards.indexOf(card);
            if (srcIdx < tgtIdx) grid.insertBefore(dragSrc, card.nextSibling);
            else grid.insertBefore(dragSrc, card);
          }
        });
      });
  })();

  // ===== מעבר בין טאבים בפאנל הצד (משימות שלי / משותפות) =====
  (function() {
    const tabsPanel = document.querySelector('.dock-tabs-panel');
    if (!tabsPanel) return;
    const tabs = tabsPanel.querySelectorAll('.dock-tab');
    const contents = tabsPanel.querySelectorAll('.dock-tab-content');

    function activateTab(name) {
      tabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-tab') === name));
      contents.forEach(c => c.classList.toggle('active', c.getAttribute('data-tab-content') === name));
    }

    // זוכר את הטאב האחרון שנבחר, לנוחות בין ביקורים
    const saved = localStorage.getItem('dock-active-tab');
    if (saved) {
      const savedTab = tabsPanel.querySelector(`.dock-tab[data-tab="${saved}"]`);
      if (savedTab) activateTab(saved);
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const name = tab.getAttribute('data-tab');
        activateTab(name);
        localStorage.setItem('dock-active-tab', name);
      });
    });
  })();

  // ניסיון חוזר לטעינת הלוגו.
  // אם בקשת התמונה נופלת על רגע לא טוב (למשל 502 בזמן שRender מפעיל את השרת
  // מחדש אחרי פריסה), התמונה נשארת ריקה עד רענון ידני. שני ניסיונות חוזרים
  // עם השהיה קצרה ופרמטר שובר-מטמון פותרים את זה בלי שהמשתמש ירגיש.
  (function retryLogo() {
    const img = document.getElementById('home-logo-img');
    if (!img) return;
    img.addEventListener('error', function () {
      const n = parseInt(img.dataset.retry || '0', 10);
      if (n >= 2) return;
      img.dataset.retry = String(n + 1);
      setTimeout(() => { img.src = '/images/logo.png?r=' + Date.now(); }, 600 * (n + 1));
    });
  })();

  // רישום Service Worker - נדרש כדי שהדפדפן יאפשר התקנה כאפליקציה (PWA)
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }
  </script>
</body>
</html>
