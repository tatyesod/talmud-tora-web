<%- include('../partials/header', {title: campaign.name, wide: true}) %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <h1>🎯 <%= campaign.name %></h1>
    <div class="actions">
      <a href="/campaigns" class="btn secondary">← חזרה לרשימה</a>
      <a href="/campaigns/<%= campaign.id %>/report" class="btn secondary">📊 דוח מבצע</a>
      <a href="/campaigns/<%= campaign.id %>/edit" class="btn secondary">✏️ עריכה</a>
    </div>
  </div>

  <% if (campaign.notes) { %><p style="color:var(--muted); font-size:0.9em;"><%= campaign.notes %></p><% } %>

  <% if (saved) { %>
    <div style="background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; border-radius:8px; padding:8px 14px; margin-bottom:12px;">✅ נשמר בהצלחה.</div>
  <% } %>

  <% if (campaign.classes.length === 0) { %>
    <p class="empty-state">אין כיתות משויכות למבצע - <a href="/campaigns/<%= campaign.id %>/edit">ערכו את המבצע</a> כדי לבחור כיתות.</p>
  <% } else if (campaign.criteria.length === 0) { %>
    <p class="empty-state">אין קריטריונים מוגדרים - <a href="/campaigns/<%= campaign.id %>/edit">ערכו את המבצע</a> כדי להוסיף.</p>
  <% } else { %>

    <form method="GET" action="/campaigns/<%= campaign.id %>" style="margin:14px 0;">
      <label>כיתה: </label>
      <select name="class_id" onchange="this.form.submit()">
        <% campaign.classes.forEach(c => { %>
          <option value="<%= c.id %>" <%= String(c.id) === classId ? 'selected' : '' %>><%= c.name %><%= c.parallel ? ' '+c.parallel : '' %> (<%= c.branch %>)</option>
        <% }) %>
      </select>
    </form>

    <% if (students.length === 0) { %>
      <p class="empty-state">אין תלמידים פעילים בכיתה זו</p>
    <% } else { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/set-counts">
        <input type="hidden" name="class_id" value="<%= classId %>" />

        <div class="campaign-save-bar">
          <span style="color:var(--muted); font-size:0.9em;">מלאו כמה שצריך, ולבסוף לחצו שמירה אחת לכל הטבלה.</span>
          <button type="submit" class="btn">💾 שמור את כל הטבלה</button>
        </div>

        <div class="table-scroll-wrap campaign-table-wrap">
          <table class="campaign-table">
            <thead>
              <tr>
                <th class="sticky-col">תלמיד</th>
                <% campaign.criteria.forEach(cr => { %><th style="text-align:center;"><%= cr.name %><br><span style="font-weight:normal; color:var(--muted); font-size:0.85em;">(<%= cr.points %> נק')</span></th><% }) %>
                <th>סה"כ נקודות</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(s => { %>
                <tr>
                  <td class="sticky-col"><strong><%= s.last_name %> <%= s.first_name %></strong></td>
                  <% campaign.criteria.forEach((cr, i) => { %>
                    <td style="text-align:center;">
                      <input type="number" name="count_<%= s.id %>_<%= cr.id %>" min="0"
                        <%= s.counts[i] > 0 ? ('value="' + s.counts[i] + '"') : 'placeholder="0"' %>
                        style="width:60px; text-align:center; padding:3px;" />
                    </td>
                  <% }) %>
                  <td style="text-align:center; font-weight:800;"><%= s.totalPoints %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="campaign-save-bar" style="margin-top:10px;">
          <button type="submit" class="btn">💾 שמור את כל הטבלה</button>
        </div>
      </form>
    <% } %>
  <% } %>
</div>

<style>
  .campaign-save-bar {
    position: sticky; top: 0; z-index: 20;
    background: var(--card-bg, #fff);
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 4px; margin-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .campaign-table-wrap { max-height: 65vh; }
  .campaign-table thead th {
    position: sticky; top: 0; z-index: 11;
    background: var(--table-header, #e8ecf0);
  }
  .campaign-table .sticky-col {
    position: sticky; right: 0; z-index: 6;
    background: var(--card-bg, #fff);
  }
  .campaign-table thead .sticky-col { z-index: 12; background: var(--table-header, #e8ecf0); }
</style>

<%- include('../partials/footer') %>
