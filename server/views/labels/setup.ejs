<%- include('../partials/header', {title: 'הדפסת מדבקות'}) %>

<div class="card">
  <h1>🏷️ הדפסת מדבקות</h1>

  <form method="GET" action="/labels/print" target="_blank">
    <div class="form-grid">

      <div class="form-group">
        <label>סוג דף מדבקות (TANEX)</label>
        <select name="format" required>
          <% Object.entries(formats).forEach(([key, f]) => { %>
            <option value="<%= key %>"><%= f.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label>תוכן המדבקה</label>
        <select name="content_type" required>
          <option value="families">משפחות (שם + כתובת)</option>
          <option value="students">תלמידים (שם + כיתה)</option>
          <option value="students_nickname">תלמידים (שם חיבה + משפחה)</option>
          <option value="teachers">מלמדים</option>
        </select>
      </div>

      <div class="form-group full">
        <%- include('../partials/branch-filter', { branches }) %>
      </div>

      <div class="form-group full">
        <label>כיתה (ריק = כולם)</label>
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
          <select name="class_id" id="class-select-labels" data-branch-filter onchange="updateStudentCount()" style="flex:1; min-width:200px;">
            <option value="" data-count="<%= totalActiveStudents %>">כל הכיתות</option>
            <% classes.forEach(c => { %>
              <option value="<%= c.id %>" data-branch="<%= c.branch || '' %>" data-count="<%= c.student_count %>"><%= c.name %><%= c.parallel ? ' ' + c.parallel : '' %></option>
            <% }) %>
          </select>
          <span id="student-count-box" style="background:#2c5f7c; color:#fff; border-radius:8px; padding:6px 12px; font-weight:700; white-space:nowrap; font-size:0.9em; flex-shrink:0;">
            <%= totalActiveStudents %> תלמידים
          </span>
        </div>
      </div>

      <div class="form-group">
        <label>כמות עותקים לכל רשומה</label>
        <select name="copies">
          <option value="1" selected>1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5">5</option>
        </select>
      </div>

    </div>

    <div style="background:#f0f4f8; border-radius:10px; padding:14px; margin:14px 0; font-size:0.88em;">
      <strong>פירוט הפורמטים:</strong>
      <table style="width:100%; margin-top:8px; border-collapse:collapse;">
        <thead><tr style="background:#e0e8f0;"><th style="padding:5px 8px; text-align:right;">פורמט</th><th style="padding:5px 8px;">בדף</th><th style="padding:5px 8px;">מידות מדבקה</th><th style="padding:5px 8px;">שימוש מומלץ</th></tr></thead>
        <tbody>
          <tr><td style="padding:5px 8px; font-weight:700;">TANEX 2133</td><td style="padding:5px 8px; text-align:center;">33 (3×11)</td><td style="padding:5px 8px; text-align:center;">70 × 25.4 מ"מ</td><td style="padding:5px 8px;">משפחות, רחב</td></tr>
          <tr style="background:#f8f9fa;"><td style="padding:5px 8px; font-weight:700;">TANEX 2072</td><td style="padding:5px 8px; text-align:center;">72 (6×12)</td><td style="padding:5px 8px; text-align:center;">46 × 21.2 מ"מ</td><td style="padding:5px 8px;">תלמידים</td></tr>
          <tr><td style="padding:5px 8px; font-weight:700;">TANEX 2120</td><td style="padding:5px 8px; text-align:center;">120 (6×20)</td><td style="padding:5px 8px; text-align:center;">38 × 13 מ"מ</td><td style="padding:5px 8px;">כמות גדולה</td></tr>
        </tbody>
      </table>
    </div>

    <div class="form-group full" style="background:#fff8e1; border-radius:10px; padding:14px; margin:14px 0;">
      <label style="font-weight:700;">⚙️ כיוונון עדין (אם השמות "בורחים" מהמדבקה בהדפסה אצלכם)</label>
      <p style="color:var(--muted); font-size:0.85em; margin:4px 0 10px;">
        לכל מדפסת יש סטייה קטנה משלה. אם ההדפסה יוצאת קצת לא במקום (למשל השם על הקו בין מדבקות) - הזיזו כאן
        במ"מ ונסו שוב. חיובי = ימינה/למטה, שלילי = שמאלה/למעלה.
      </p>
      <div class="form-grid">
        <div class="form-group">
          <label>הזזה אנכית (מ"מ)</label>
          <input type="number" name="offset_top" value="0" step="0.5" style="width:100px;" />
        </div>
        <div class="form-group">
          <label>הזזה אופקית (מ"מ)</label>
          <input type="number" name="offset_side" value="0" step="0.5" style="width:100px;" />
        </div>
      </div>
    </div>

    <div class="actions">
      <button type="submit" class="btn">🖨️ הפק מדבקות</button>
      <button type="submit" formaction="/labels/export-docx" class="btn secondary">📄 ייצוא לוורד (לעריכה ידנית)</button>
      <a href="/reports" class="btn secondary">חזרה לדוחות</a>
    </div>
  </form>
</div>

<script>
  function updateStudentCount() {
    const select = document.getElementById('class-select-labels');
    const opt = select.options[select.selectedIndex];
    const count = opt ? (opt.getAttribute('data-count') || '0') : '0';
    const suffix = select.value === '' ? 'תלמידים (כל הכיתות)' : 'תלמידים בכיתה זו';
    document.getElementById('student-count-box').textContent = count + ' ' + suffix;
  }
</script>

<%- include('../partials/footer') %>
