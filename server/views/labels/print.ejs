<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>מדבקות</title>
  <%
    // מחשבים שוליים מותאמים לפי כיוונון עדין שהוזן (אם הוזן), כדי לתקן סטייה
    // ספציפית למדפסת של המשתמש
    const baseMarginTop = parseFloat(fmt.pageMarginTop) || 0;
    const baseMarginSide = parseFloat(fmt.pageMarginSide) || 0;
    const adjustedMarginTop = baseMarginTop + (typeof offsetTopMM !== 'undefined' ? offsetTopMM : 0);
    const adjustedMarginSide = baseMarginSide + (typeof offsetSideMM !== 'undefined' ? offsetSideMM : 0);
  %>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    @page { size: A4 portrait; margin: 0; }

    body { font-family: Arial, 'Arial Hebrew', sans-serif; direction: rtl; background: #fff; }

    .no-print {
      background: #2c5f7c; color: #fff; padding: 10px 16px;
      display: flex; gap: 12px; align-items: center; font-size: 14px;
    }
    .no-print button { background:#fff; color:#2c5f7c; border:none; border-radius:6px; padding:6px 16px; cursor:pointer; font-weight:700; }
    .no-print a { color:#fff; }
    @media print { .no-print { display: none; } }

    .label-page {
      width: 210mm;
      height: 296mm;
      overflow: hidden;
      padding-top: <%= adjustedMarginTop %>mm;
      padding-right: <%= adjustedMarginSide %>mm;
      padding-left: <%= adjustedMarginSide %>mm;
      page-break-after: always;
    }
    div.label-page:last-of-type { page-break-after: auto; }

    .label-row {
      display: flex;
      flex-direction: row; /* RTL: right to left naturally */
      gap: 0;
    }

    .label {
      width: <%= fmt.labelW %>;
      height: <%= fmt.labelH %>;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 0.8mm 3.2mm;
      font-size: <%= fmt.fontSize %>;
      font-family: "FrankRuehl", "FrankRuehlCLM", "Guttman Mantova", Arial, sans-serif;
      font-weight: bold;
      direction: rtl;
      text-align: center;
    }

    .label-line1 { font-size: 0.85em; color: #555; line-height: 1.2; width:100%; text-align: center; }
    .label-line2 { font-weight: bold; font-size: 1.05em; line-height: 1.3; width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-align: center; }
    .label-line3 { font-size: 0.88em; line-height: 1.2; width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-align: center; }

    /* מדבקה עם שורה אחת בלבד (בלי line1/line3) - עדיין ממורכזת יפה, אבל
       בלי הגדלה נוספת מעבר לגודל הפונט שנבחר, כדי לא לגלוש מהמדבקה */
    .label.single-line .label-line2 { font-size: 1em; white-space: normal; overflow-wrap: break-word; text-overflow: clip; line-height: 1.08; }

    /* מדבקת שם מפוצל לשתי שורות קבועות (שם פרטי/חיבה בשורה 1, שם משפחה
       בשורה 2) - שתי השורות באותו גודל ומשקל, כדי שלא תיראה אחת "פחות
       חשובה" מהשנייה. גודל פונט ייעודי, בדרך כלל גדול יותר מהבסיס, כי כל
       שורה צריכה להכיל רק מילה אחת */
    .label.name-split { font-size: <%= fmt.nameSplitFontSize || fmt.fontSize %>; <% if (fmt.nameSplitPadV) { %>padding-top: <%= fmt.nameSplitPadV %>; padding-bottom: <%= fmt.nameSplitPadV %>;<% } %> }
    .label.name-split .label-line1 { font-size: 1em; color: inherit; font-weight: bold; line-height: 1.08; white-space: nowrap; overflow: hidden; }
    .label.name-split .label-line2 { font-size: 1em; font-weight: bold; line-height: 1.08; white-space: nowrap; overflow: hidden; text-overflow: clip; }


    .show-borders .label { border: 0.3pt dashed #bbb; }
  </style>
</head>
<body>

<div class="no-print">
  <button onclick="window.print()">🖨️ הדפסה</button>
  <span><strong><%= items.length %></strong> מדבקות | TANEX <%= format %> (<%= fmt.perPage %> בדף)</span>
  <label style="cursor:pointer;">
    <input type="checkbox" id="show-borders" style="margin-left:4px;" />
    הצג קווי מדבקה
  </label>
  <a href="javascript:history.back()">← חזרה</a>
</div>

<%
const pages = [];
let current = [];
items.forEach((item, i) => {
  current.push(item);
  if (current.length === fmt.perPage || i === items.length - 1) {
    pages.push([...current]);
    current = [];
  }
});
%>

<% pages.forEach(page => { %>
<div class="label-page">
  <%
  const allRows = [];
  for (let r = 0; r < fmt.rows; r++) {
    const rowItems = [];
    for (let c = 0; c < fmt.cols; c++) {
      const idx = r * fmt.cols + c;
      rowItems.push(idx < page.length ? page[idx] : null);
    }
    allRows.push(rowItems);
  }
  %>
  <% allRows.forEach(row => { %>
    <div class="label-row">
      <% row.forEach(item => { %>
        <div class="label<%= !item ? '' : (item.isTeacher ? ' teacher' : '') + (item.isNameSplit ? ' name-split' : (!item.line1 && !item.line3 ? ' single-line' : '')) %>">
          <% if (item) { %>
            <% if (item.line1) { %><div class="label-line1"><%= item.line1 %></div><% } %>
            <div class="label-line2"><%= item.line2 %></div>
            <% if (item.line3) { %><div class="label-line3"><%= item.line3 %></div><% } %>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% }) %>
</div>
<% }) %>

<script>
document.getElementById('show-borders').addEventListener('change', function() {
  document.querySelectorAll('.label-page').forEach(p => p.classList.toggle('show-borders', this.checked));
});
</script>
</body>
</html>
