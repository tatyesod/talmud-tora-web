<%- include('../partials/header', {title: 'יומן שיחות'}) %>

<div class="card">
  <h1>📞 יומן שיחות</h1>

  <p style="color:var(--muted); font-size:0.9em; line-height:1.7;">
    כל השיחות הנכנסות שנרשמו. שיחה שפספסת אינה נעלמת — היא כאן.
    לחיצה על שם פותחת את הכרטיס.
  </p>

  <div style="display:flex; gap:18px; flex-wrap:wrap; margin:12px 0; font-size:0.94em;">
    <span>תאריך: <strong><%= isoDay.split('-').reverse().join('/') %></strong></span>
    <span>שיחות: <strong><%= calls.length %></strong></span>
    <span style="color:#2d7a4f;">מזוהות: <strong><%= known %></strong></span>
    <% if (calls.length - known) { %>
      <span style="color:#a6740c;">לא מוכרות: <strong><%= calls.length - known %></strong></span>
    <% } %>
  </div>

  <%# בורר יום. מוצגים רק ימים שיש בהם שיחות - אין טעם לדפדף בריקים. %>
  <%# אבחון: כשהפס בדף הבית ריק, כאן רואים למה. מוצג רק כשיש בעיה. %>
  <% if (!myExt) { %>
    <div style="background:#fff8e6; border:1px solid #e0c880; border-radius:8px;
                padding:10px 15px; margin-bottom:12px; font-size:0.9em; line-height:1.7;">
      <strong>לא מוגדרת לך שלוחה.</strong> לכן לא יוצגו שיחות בדף הבית.<br>
      להגדרה: משתמשים ← עריכת המשתמש ← שדה "שלוחת טלפון".
      <strong>אחרי השמירה צריך להתנתק ולהתחבר מחדש</strong> — השלוחה נטענת בהתחברות.
    </div>
  <% } else if (calls.length === 0 && !showAll) { %>
    <div style="background:#fff8e6; border:1px solid #e0c880; border-radius:8px;
                padding:10px 15px; margin-bottom:12px; font-size:0.9em; line-height:1.7;">
      השלוחה שלך היא <strong><%= myExt %></strong>, ואין שיחות שהגיעו אליה ביום זה.<br>
      ודא שבכתובת ב-3CX מופיע <code dir="ltr">&amp;to=<%= myExt %></code> בסופה.
      <a href="/phone/calls?all=1&day=<%= isoDay %>">הצגת כל השיחות</a>
    </div>
  <% } %>

  <% if (typeof group !== 'undefined' && group.length > 1) { %>
    <div style="background:#e8f5ec; border:1px solid #2d7a4f; border-radius:8px;
                padding:8px 14px; margin-bottom:12px; font-size:0.9em;">
      מוצגות שיחות של שלוחות <strong><%= group.join(", ") %></strong> יחד.
      <a href="/phone/calls?day=<%= isoDay %>">הצגת כל השיחות</a>
    </div>
  <% } %>

  <% if (days.length > 1) { %>
    <div class="form-group" style="max-width:280px;">
      <label>יום</label>
      <select onchange="location.href='/phone/calls?day=' + this.value">
        <% days.forEach(d => { %>
          <option value="<%= d.d %>" <%= d.d === isoDay ? 'selected' : '' %>>
            <%= d.d.split('-').reverse().join('/') %> — <%= d.n %> שיחות
          </option>
        <% }) %>
      </select>
    </div>
  <% } %>

  <% if (calls.length === 0) { %>
    <p class="empty-state">אין שיחות רשומות ביום זה.</p>
  <% } else { %>
    <div class="table-scroll-wrap">
      <table>
        <thead>
          <tr><th>שעה</th><th>מי התקשר</th><th>תקציר השיחה</th><th>מספר</th><th></th></tr>
        </thead>
        <tbody>
          <% calls.forEach(c => { %>
            <tr>
              <td style="white-space:nowrap;">
                <%= new Date(c.created_at).toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' }) %>
              </td>
              <td>
                <% if (c.matched_title) { %>
                  <strong><%= c.matched_title %></strong>
                <% } else { %>
                  <span style="color:#a6740c;">אינו מוכר במערכת</span>
                <% } %>
              </td>
              <%# תקציר נערך במקום, בלי לעבור מסך %>
              <td>
                <form method="POST" action="/phone/calls/<%= c.id %>/note" style="display:flex; gap:5px;">
                  <input type="hidden" name="back" value="/phone/calls?day=<%= isoDay %><%= ext ? '&ext=' + ext : '' %>" />
                  <input type="text" name="note" value="<%= c.note || '' %>"
                         placeholder="<%= c.matched_subtitle || 'מה סוכם…' %>"
                         style="flex:1; font-size:0.88em; padding:3px 6px;" />
                  <button type="submit" class="btn small secondary" title="שמירה">💾</button>
                </form>
              </td>
              <td style="direction:ltr; text-align:right;"><%= c.number %></td>
              <td style="width:1%; white-space:nowrap;">
                <% if (c.target_url) { %>
                  <a href="<%= c.target_url %>" class="btn small secondary">פתיחה</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="actions" style="margin-top:16px;">
    <a href="/" class="btn secondary">חזרה לדף הבית</a>
    <%# קיבוץ שלוחות: למי שעובד בשתי שלוחות בשני סניפים %>
    <a href="/phone/groups" class="btn secondary">🔗 קיבוץ שלוחות</a>
  </div>

  <p style="color:var(--muted); font-size:0.8em; margin-top:14px;">
    שיחות נשמרות 30 יום ואז נמחקות אוטומטית.
  </p>
</div>

<%- include('../partials/footer') %>
