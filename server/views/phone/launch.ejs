<!DOCTYPE html>
<html lang="he" dir="rtl"><head><meta charset="UTF-8"><title>שיחה</title>
<%# דף משגר מינימלי בכוונה.
    3CX בגרסה זו יודעת רק לפתוח כתובת - אין בה אפשרות להריץ תוכנית -
    ולכן לשונית הביניים היא הכרח. מה שכן בשליטתנו הוא כמה זמן היא
    נראית: הסקריפט רץ בתוך ה-head, לפני שהדפדפן צייר משהו, וכך
    ההבזק הלבן נחסך.
    הרקע כהה כדי שגם אם ייראה משהו - הוא יתמזג ולא יהבהב לבן. %>
<style>html,body{background:#0d1b2e;margin:0;height:100%}</style>
<script>
(function () {
  var url = <%- JSON.stringify(target) %>;
  // שם קבוע: שיחה חדשה מחליפה את התוכן בחלון הקיים במקום להצטבר
  var w = window.open(url, "ttcall",
    "width=430,height=620,left=40,top=300,menubar=no,toolbar=no,location=no,status=no");
  if (w) {
    // בכוונה בלי focus: משיכת המיקוד מוציאה את המשתמש ממה שהוא עובד
    // בו - אופיס, מייל, או המערכת עצמה. החלון נפתח לצד המסך ומחכה.
    // blur על החלון הזה מחזיר את המיקוד למקום שממנו הגיע.
    // סגירה מיידית. נחסמת ברוב הדפדפנים כי הלשונית לא נפתחה מקוד,
    // ואז מוצג התוכן שב-body במקום דף לבן.
    // מחזירים את המיקוד לחלון הקודם לפני הסגירה, אחרת ווינדוס
    // מעביר אותו לחלון שרירותי.
    try { window.blur(); } catch (e) {}
    window.close();
  } else {
    // חלונות קופצים חסומים - מפנים את הלשונית עצמה ליעד,
    // כך שלפחות הכרטיס ייפתח.
    window.location.replace(url);
  }
})();
</script>
</head>
<body>
<div style="font-family:'Segoe UI',Arial,sans-serif;direction:rtl;color:#9fb0c2;
            text-align:center;padding:40px 20px;font-size:0.9em;line-height:1.9">
  ✓ כרטיס המתקשר נפתח בחלון נפרד.<br>
  <span style="opacity:.7">אפשר לסגור את הלשונית הזו.</span>
</div>
</body></html>
