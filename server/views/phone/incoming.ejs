<%- include('../partials/header', {title: 'שיחה נכנסת'}) %>

<div class="card">
  <h1>📞 שיחה נכנסת</h1>
  <p style="font-size:1.3em; font-weight:700; direction:ltr; text-align:right; margin:6px 0 16px;">
    <%= number %>
  </p>

  <% if (matches.length === 0) { %>
    <div style="background:#fff3cd; border:1px solid #e0a800; border-radius:8px; padding:12px 16px;">
      <strong>המספר אינו מוכר במערכת.</strong><br>
      ייתכן שזו משפחה חדשה, או שהמספר שמור בפורמט אחר.
    </div>
    <div class="actions" style="margin-top:14px;">
      <a href="/families?q=<%= encodeURIComponent(number) %>" class="btn secondary">חיפוש במשפחות</a>
      <a href="/students?q=<%= encodeURIComponent(number) %>" class="btn secondary">חיפוש בתלמידים</a>
      <a href="/families/new" class="btn secondary">רישום משפחה חדשה</a>
    </div>
  <% } else { %>
    <p style="color:var(--muted); font-size:0.9em;">
      נמצאו <%= matches.length %> התאמות למספר הזה. בחר את הכרטיס המבוקש.
    </p>
    <table>
      <thead><tr><th>שם</th><th>פרטים</th><th>השדה שהתאים</th><th></th></tr></thead>
      <tbody>
        <% matches.forEach(m => { %>
          <tr>
            <td style="font-weight:700;"><%= m.title %></td>
            <td><%= m.subtitle || '' %></td>
            <td style="color:var(--muted);"><%= m.matchedField %></td>
            <td><a href="<%= m.url %>" class="btn small">פתיחה</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
