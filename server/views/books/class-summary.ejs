<%- include('../partials/header', {title: 'סיכום הזמנות לפי כיתה', wide: true}) %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <h1>📊 סיכום הזמנות לפי כיתה</h1>
    <div class="actions">
      <a href="/books" class="btn secondary">← חזרה</a>
      <% if (perClassLists.length > 0) { %>
        <a href="/books/class-summary/export?branch=<%= encodeURIComponent(branch) %>&year=<%= encodeURIComponent(year) %>" class="btn">📥 ייצוא ל-Excel</a>
        <button type="button" class="btn secondary" onclick="window.print()">🖨️ הדפס</button>
      <% } %>
    </div>
  </div>

  <p style="color:var(--muted); font-size:0.9em;" class="no-print">
    לכל כיתה - רשימה נפרדת של הספרים שלה, עם כמות ההזמנות (רגילות + חידושים) לכל ספר - כדי לדעת בדיוק כמה להכין
    לכל כיתה.
  </p>

  <form method="GET" action="/books/class-summary" class="no-print" style="display:flex; gap:14px; margin:14px 0;">
    <div>
      <label>סניף: </label>
      <select name="branch" onchange="this.form.submit()">
        <% branches.forEach(b => { %>
          <option value="<%= b %>" <%= b === branch ? 'selected' : '' %>><%= b %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label>שנה: </label>
      <select name="year" onchange="this.form.submit()">
        <% years.forEach(y => { %>
          <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
        <% }) %>
      </select>
    </div>
  </form>

  <% if (perClassLists.length === 0) { %>
    <p class="empty-state">אין כיתות/קטלוג ספרים לסניף/שנה שנבחרו</p>
  <% } else { %>
    <div class="class-lists-grid">
      <% perClassLists.forEach(cls => { %>
        <div class="class-list-card">
          <h3><%= cls.className %></h3>
          <% if (cls.items.length === 0) { %>
            <p class="empty-state" style="font-size:0.85em;">אין ספרים בקטלוג הכיתה</p>
          <% } else { %>
            <table>
              <thead><tr><th>ספר</th><th>כמות</th></tr></thead>
              <tbody>
                <% cls.items.forEach(it => { %>
                  <tr class="<%= it.count > 0 ? 'has-count' : '' %>">
                    <td><%= it.itemName %></td>
                    <td style="text-align:center; font-weight:<%= it.count > 0 ? '700' : '400' %>;"><%= it.count > 0 ? it.count : '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr style="font-weight:800; border-top:2px solid var(--border);">
                  <td>סה"כ</td>
                  <td style="text-align:center;"><%= cls.classTotal %></td>
                </tr>
              </tfoot>
            </table>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<style>
  .class-lists-grid { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 10px; }
  .class-list-card { flex: 1 1 300px; max-width: 380px; border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; background: var(--card-bg, #fff); page-break-inside: avoid; }
  .class-list-card h3 { margin: 0 0 8px; padding-bottom: 6px; border-bottom: 2px solid var(--border); }
  .class-list-card table { width: 100%; border-collapse: collapse; font-size: 0.92em; }
  .class-list-card th, .class-list-card td { padding: 4px 6px; border-bottom: 1px solid var(--border); }
  .class-list-card tr.has-count { background: #eef5fb; }
  @media print {
    @page { size: landscape; margin: 10mm; }
    .no-print, header.topbar, nav { display: none !important; }
    body { background: #fff; }
    .card { box-shadow: none; border: none; padding: 0; }
    .class-lists-grid { display: flex; flex-wrap: wrap; gap: 10px; }
    .class-list-card {
      flex: 0 0 calc(25% - 8px);
      max-width: calc(25% - 8px);
      padding: 8px 10px;
      font-size: 0.85em;
      page-break-inside: avoid;
    }
    .class-list-card h3 { font-size: 1em; margin-bottom: 4px; padding-bottom: 4px; }
    .class-list-card table { font-size: 0.85em; }
    .class-list-card th, .class-list-card td { padding: 2px 4px; }
  }
</style>

<%- include('../partials/footer') %>
