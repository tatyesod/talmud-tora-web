<%- include('../partials/header', {title: 'סיכום הזמנות לפי כיתה וספר', wide: true}) %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <h1>📊 סיכום הזמנות לפי כיתה וספר</h1>
    <div class="actions">
      <a href="/books" class="btn secondary">← חזרה</a>
      <% if (books.length > 0) { %>
        <a href="/books/class-summary/export?branch=<%= encodeURIComponent(branch) %>&year=<%= encodeURIComponent(year) %>" class="btn">📥 ייצוא ל-Excel</a>
        <button type="button" class="btn secondary" onclick="window.print()">🖨️ הדפס</button>
      <% } %>
    </div>
  </div>

  <p style="color:var(--muted); font-size:0.9em;" class="no-print">
    לכל כיתה - כמה מכל ספר הוזמן (הזמנות רגילות + חידושים). בשורה האחרונה - סה"כ לכל ספר, על פני כל הכיתות, כדי
    לדעת כמה להכין מכל ספר וספר.
  </p>

  <form method="GET" action="/books/class-summary" class="no-print" style="display:flex; gap:14px; margin:14px 0;">
    <div>
      <label>סניף: </label>
      <select name="branch" onchange="this.form.submit()">
        <% branches.forEach(b => { %>
          <option value="<%= b %>" <%= b === branch ? 'selected' : '' %>><%= b %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label>שנה: </label>
      <select name="year" onchange="this.form.submit()">
        <% years.forEach(y => { %>
          <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
        <% }) %>
      </select>
    </div>
  </form>

  <% if (books.length === 0) { %>
    <p class="empty-state">אין קטלוג ספרים לסניף/שנה שנבחרו</p>
  <% } else { %>
    <div class="table-scroll-wrap">
      <table class="matrix-table">
        <thead>
          <tr>
            <th class="sticky-col" style="background:var(--table-header, #e8ecf0);">כיתה</th>
            <% books.forEach(b => { %>
              <th class="rotated-th"><div><span><%= b %></span></div></th>
            <% }) %>
            <th style="font-weight:800; min-width:70px;">סה"כ<br>כיתה</th>
          </tr>
        </thead>
        <tbody>
          <% matrix.forEach((row, i) => { %>
            <tr class="<%= i % 2 === 1 ? 'zebra' : '' %>">
              <td class="sticky-col" style="background:<%= i % 2 === 1 ? 'var(--zebra-bg, #f7f8fa)' : 'var(--card-bg, #fff)' %>; font-weight:700;"><%= row.className %></td>
              <% row.counts.forEach(c => { %><td class="count-cell <%= c > 0 ? 'has-count' : '' %>"><%= c > 0 ? c : '·' %></td><% }) %>
              <td class="count-cell" style="font-weight:700;"><%= row.rowTotal %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr style="font-weight:800; border-top:2px solid var(--border);">
            <td class="sticky-col" style="background:var(--table-header, #e8ecf0);">סה"כ לכל הכיתות</td>
            <% columnTotals.forEach(t => { %><td class="count-cell"><%= t %></td><% }) %>
            <td class="count-cell"><%= grandTotal %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } %>
</div>

<style>
  .matrix-table { border-collapse: collapse; }
  .matrix-table th, .matrix-table td { border: 1px solid var(--border); }
  .matrix-table .sticky-col { position: sticky; right: 0; z-index: 6; min-width: 110px; text-align: right; padding: 6px 10px; }
  thead .sticky-col { z-index: 12; }
  .rotated-th { min-width: 34px; max-width: 34px; height: 130px; padding: 0; vertical-align: bottom; }
  .rotated-th > div { display: flex; align-items: center; justify-content: flex-start; width: 34px; }
  .rotated-th span { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font-size: 0.82em; font-weight: 600; padding-bottom: 6px; }
  .count-cell { text-align: center; min-width: 34px; padding: 6px 4px; color: var(--muted); }
  .count-cell.has-count { color: inherit; font-weight: 700; background: #eef5fb; }
  tr.zebra td:not(.sticky-col) { background: var(--zebra-bg, #fafbfc); }
  tr.zebra td.has-count { background: #e4eef7; }
</style>

<style>
  @media print {
    .no-print, header.topbar, nav { display: none !important; }
    .table-scroll-wrap { overflow: visible !important; max-height: none !important; }
  }
</style>

<%- include('../partials/footer') %>
