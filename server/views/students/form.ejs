<%- include('../partials/header', {title: mode === 'new' ? 'תלמיד חדש' : 'עריכת תלמיד'}) %>

<div class="card">
  <h1><%= mode === 'new' ? 'הוספת תלמיד חדש' : 'עריכת תלמיד' %></h1>

  <% if (typeof conflict !== 'undefined' && conflict) { %>
    <div style="background:#fdecea; border:1px solid #f5c6cb; color:#a94442; border-radius:8px; padding:10px 16px; margin-bottom:14px;">
      ⚠️ מישהו אחר עדכן את הכרטיס הזה בינתיים, אחרי שפתחת אותו לעריכה. הנתונים המוצגים כאן עכשיו הם המעודכנים ביותר — יש לבדוק אותם ולבצע שוב את השינוי הרצוי לפני שמירה חוזרת.
    </div>
  <% } %>

  <% if (typeof duplicateIdError !== 'undefined' && duplicateIdError) { %>
    <div style="background:#fdecea; border:1px solid #f5c6cb; color:#a94442; border-radius:8px; padding:10px 16px; margin-bottom:14px;">
      🚫 <strong>לא ניתן לשמור</strong> - <%= duplicateIdError %>
    </div>
  <% } %>

  <form method="POST" action="<%= mode === 'new' ? '/students' : '/students/' + student.id + '?_method=PUT' %>">
    <input type="hidden" name="back" value="<%= typeof back !== 'undefined' ? back : '' %>" />
    <% if (mode === 'edit') { %><input type="hidden" name="updated_at" value="<%= student.updated_at || '' %>" /><% } %>

    <% if (typeof siblingBranchWarning !== 'undefined' && siblingBranchWarning) { %>
      <div style="background:#fff8e1; border:1px solid #ffe082; color:#8a6d00; border-radius:8px; padding:10px 16px; margin-bottom:14px;">
        ⚠️ <strong>שים לב</strong> - <%= siblingBranchWarning %>
        <label style="display:block; font-weight:normal; margin-top:8px;">
          <input type="checkbox" name="confirm_sibling_mismatch" value="1" style="width:auto; margin-left:6px;" />
          כן, לשבץ בכל זאת לסניף שנבחר (למרות שהוא שונה מהאח/אחות)
        </label>
      </div>
    <% } %>

    <% if (typeof cohortMismatchWarning !== 'undefined' && cohortMismatchWarning) { %>
      <div style="background:#fff8e1; border:1px solid #ffe082; color:#8a6d00; border-radius:8px; padding:10px 16px; margin-bottom:14px;">
        ⚠️ <strong>שים לב</strong> - <%= cohortMismatchWarning %>
        <label style="display:block; font-weight:normal; margin-top:8px;">
          <input type="checkbox" name="confirm_cohort_mismatch" value="1" style="width:auto; margin-left:6px;" />
          כן, לשבץ בכל זאת לכיתה שנבחרה (למרות שהשנתון לא תואם)
        </label>
      </div>
    <% } %>

    <%# ======= פרטים אישיים ======= %>
    <fieldset>
      <legend>פרטים אישיים</legend>
      <div class="form-grid">
        <div class="form-group"><label>שם משפחה</label><input type="text" name="last_name" value="<%= student.last_name || '' %>" /></div>
        <div class="form-group"><label>שם פרטי</label><input type="text" name="first_name" value="<%= student.first_name || '' %>" /></div>
        <div class="form-group"><label>כינוי</label><input type="text" name="nickname" value="<%= student.nickname || '' %>" /></div>
        <div class="form-group"><label>תעודת זהות</label><input type="text" class="israeli-id-input" name="id_number" value="<%= student.id_number || '' %>" /></div>
        <div class="form-group"><label>תאריך לידה</label><input type="date" id="birth_date_civil_input" name="birth_date_civil" value="<%= student.birth_date_civil || '' %>" /></div>
        <div class="form-group">
          <label>סטטוס</label>
          <select name="status">
            <option value="פעיל" <%= student.status === 'פעיל' ? 'selected' : '' %>>פעיל</option>
            <option value="נרשם" <%= student.status === 'נרשם' ? 'selected' : '' %>>נרשם</option>
            <option value="לא פעיל" <%= student.status === 'לא פעיל' || !student.status ? 'selected' : '' %>>לא פעיל</option>
            <option value="ארכיון" <%= student.status === 'ארכיון' ? 'selected' : '' %>>ארכיון</option>
            <option value="לא התקבל" <%= student.status === 'לא התקבל' ? 'selected' : '' %>>לא התקבל</option>
          </select>
        </div>
        <%# רלוונטי רק לארכיון. מוצג תמיד כדי שהערך יישלח גם אם הסטטוס משתנה
            באותה שמירה, אך מתעמעם כשהסטטוס אינו "ארכיון" כדי לא לבלבל. %>
        <div class="form-group" id="archive-type-group">
          <label>סוג ארכיון</label>
          <select name="archive_type">
            <option value="">--</option>
            <option value="בוגר" <%= student.archive_type === 'בוגר' ? 'selected' : '' %>>בוגר (סיים כיתה ח')</option>
            <option value="עזב" <%= student.archive_type === 'עזב' ? 'selected' : '' %>>עזב (לא סיים)</option>
          </select>
          <small style="color:var(--muted);">רלוונטי לסטטוס "ארכיון" בלבד. מסומן אוטומטית כ"בוגר" בהעלאת שנה למסיימי כיתה ח'.</small>
        </div>
        <div class="form-group">
          <label>הולך לבדו</label>
          <select name="walks_alone">
            <option value="">--</option>
            <option value="כן" <%= student.walks_alone === 'כן' ? 'selected' : '' %>>כן</option>
            <option value="לא" <%= student.walks_alone === 'לא' ? 'selected' : '' %>>לא</option>
          </select>
        </div>
        <div class="form-group"><label>קופת חולים</label><input type="text" name="health_fund" value="<%= student.health_fund || '' %>" /></div>
        <div class="form-group"><label>אלרגיות</label><input type="text" name="allergies" value="<%= student.allergies || '' %>" /></div>
        <div class="form-group"><label>תרופות קבועות</label><input type="text" name="medications" value="<%= student.medications || '' %>" /></div>
        <div class="form-group"><label>ארץ הלידה</label><input type="text" name="birth_country" value="<%= student.birth_country || 'ישראל' %>" /></div>
        <div class="form-group"><label>שנת עלייה (אם לא נולד בארץ)</label><input type="text" name="immigration_year" value="<%= student.immigration_year || '' %>" /></div>
        <div class="form-group full"><label>הערות</label><textarea name="notes"><%= student.notes || '' %></textarea></div>
      </div>
    </fieldset>

    <%# ======= כיתה ומחזור ======= %>
    <fieldset>
      <legend>כיתה ומחזור</legend>
      <div class="form-grid">
        <div class="form-group">
          <label>כיתה</label>
          <select name="class_id">
            <option value="">--</option>
            <% classes.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(student.class_id) === String(c.id) ? 'selected' : '' %>><%= c.name %><%= c.parallel ? ' ('+c.parallel+')' : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>סניף</label>
          <select name="branch">
            <option value="">-- (לפי הכיתה, אם יש)</option>
            <option value="סוקולוב" <%= student.branch === 'סוקולוב' ? 'selected' : '' %>>סוקולוב</option>
            <option value="נפחא" <%= student.branch === 'נפחא' ? 'selected' : '' %>>נפחא</option>
            <option value="בן פתחיה" <%= student.branch === 'בן פתחיה' ? 'selected' : '' %>>בן פתחיה</option>
          </select>
          <p style="color:var(--muted); font-size:0.8em; margin-top:2px;">
            משתבץ אוטומטית לפי כתובת המשפחה. אפשר לשנות ידנית כאן במקרה חריג (למשל אם ההורים מעדיפים סניף אחר).
          </p>
        </div>
        <div class="form-group">
          <label>מחזור</label>
          <select name="cohort_id" id="cohort_id_select">
            <option value="">--</option>
            <% cohorts.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(student.cohort_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
          <span id="cohort_auto_hint" style="display:none; font-size:0.82em; color:#2e7d32; margin-top:4px;"></span>
        </div>
        <div class="form-group"><label>תאריך רישום</label><input type="date" name="registration_date" value="<%= student.registration_date || '' %>" /></div>
        <div class="form-group"><label>תאריך קבלה</label><input type="date" name="admission_date" value="<%= student.admission_date || '' %>" /></div>
        <div class="form-group"><label>תאריך כניסה</label><input type="date" name="entry_date" value="<%= student.entry_date || '' %>" /></div>
        <div class="form-group"><label>תאריך יציאה</label><input type="date" name="exit_date" value="<%= student.exit_date || '' %>" /></div>
      </div>
    </fieldset>

    <%# ======= סייע ======= %>
    <fieldset>
      <legend>סייע / מסייע</legend>
      <div class="form-grid">
        <div class="form-group">
          <label>זכאי לסייע</label>
          <select name="aide_eligible" id="aide-eligible">
            <option value="">--</option>
            <option value="כן" <%= student.aide_eligible === 'כן' ? 'selected' : '' %>>כן</option>
            <option value="לא" <%= student.aide_eligible === 'לא' ? 'selected' : '' %>>לא</option>
          </select>
        </div>
        <div class="form-group">
          <label>סוג הסיוע</label>
          <select name="aide_type">
            <option value="">--</option>
            <option value="רפואי" <%= student.aide_type === 'רפואי' ? 'selected' : '' %>>רפואי</option>
            <option value="לימודי" <%= student.aide_type === 'לימודי' ? 'selected' : '' %>>לימודי</option>
          </select>
        </div>
        <div class="form-group"><label>שם הסייע</label><input type="text" name="aide_name" value="<%= student.aide_name || '' %>" /></div>
        <div class="form-group"><label>נייד הסייע</label><input type="tel" name="aide_mobile" value="<%= student.aide_mobile || '' %>" /></div>
        <div class="form-group"><label>ת.ז הסייע</label><input type="text" class="israeli-id-input" name="aide_id_number" value="<%= student.aide_id_number || '' %>" /></div>
        <div class="form-group"><label>כמות שעות</label><input type="text" name="aide_hours" value="<%= student.aide_hours || '' %>" placeholder="לדוגמה: 10 שבועיות" /></div>
        <div class="form-group"><label>למי משולם</label><input type="text" name="aide_payer" value="<%= student.aide_payer || '' %>" /></div>
      </div>
      <p style="color:var(--muted); font-size:0.85em; margin-top:6px;">
        שדות הסייע רלוונטיים כאשר "זכאי לסייע" = כן. הם נשמרים בכל מקרה, כדי שלא יאבד מידע אם הזכאות משתנה.
      </p>
    </fieldset>

    <%# ======= משפחה / הורים ======= %>
    <fieldset>
      <legend>משפחה / הורים</legend>

      <!-- בחירת משפחה קיימת או חדשה - זמין גם בעריכה, לא רק ביצירה, כדי
           שאפשר יהיה להוסיף הורים גם לתלמיד שכבר נשמר בלי משפחה -->
      <div style="display:flex; gap:20px; margin-bottom:16px; align-items:center;">
        <label style="cursor:pointer; font-size:1em; font-weight:600;">
          <input type="radio" name="family_mode" value="existing" id="fam-existing" <%= student.family_id ? 'checked' : '' %> style="width:auto; margin-left:6px;" />
          בחר משפחה קיימת
        </label>
        <label style="cursor:pointer; font-size:1em; font-weight:600;">
          <input type="radio" name="family_mode" value="new" id="fam-new" <%= !student.family_id ? 'checked' : '' %> style="width:auto; margin-left:6px;" />
          משפחה חדשה — מלא פרטים
        </label>
      </div>

      <!-- בחירת משפחה קיימת -->
      <div id="section-existing">
        <div class="form-grid">
          <div class="form-group">
            <label>משפחה קיימת</label>
            <select name="family_id" id="family_id_select" onchange="syncSectorFromFamily()">
              <option value="">--</option>
              <% families.forEach(f => { %>
                <option value="<%= f.id %>" data-sector="<%= f.sector || '' %>" <%= String(student.family_id) === String(f.id) ? 'selected' : '' %>><%= f.last_name %><%= f.father_name ? ' — ' + f.father_name : '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>מגזר</label>
            <select name="sector" id="sector_select">
              <option value="">--</option>
              <option value="ליטאי" <%= student.sector === 'ליטאי' ? 'selected' : '' %>>ליטאי</option>
              <option value="ספרדי" <%= student.sector === 'ספרדי' ? 'selected' : '' %>>ספרדי</option>
              <option value="תמני" <%= student.sector === 'תמני' ? 'selected' : '' %>>תמני</option>
            </select>
          </div>
        </div>
      </div>

      <!-- פרטי משפחה חדשה -->
      <div id="section-new-family" style="display:none;">

        <h3 style="margin:14px 0 8px; color:var(--primary); font-size:1em;">פרטי האב</h3>
        <div class="form-grid">
          <div class="form-group"><label>שם משפחה</label><input type="text" name="fam_last_name" /></div>
          <div class="form-group"><label>שם האב</label><input type="text" name="fam_father_name" /></div>
          <div class="form-group"><label>ת.ז אב</label><input type="text" class="israeli-id-input" name="fam_father_id_number" /></div>
          <div class="form-group"><label>נייד אב</label><input type="tel" name="fam_father_mobile" /></div>
          <div class="form-group"><label>מייל אב</label><input type="email" name="fam_father_email" /></div>
          <div class="form-group"><label>מקום עבודה אב</label><input type="text" name="fam_father_workplace" /></div>
          <div class="form-group"><label>טל' עבודה אב</label><input type="tel" name="fam_father_work_phone" /></div>
          <div class="form-group">
            <label>מגזר</label>
            <select name="fam_sector">
              <option value="">--</option>
              <option value="ליטאי">ליטאי</option>
              <option value="ספרדי">ספרדי</option>
              <option value="תמני">תמני</option>
            </select>
          </div>
        </div>

        <h3 style="margin:14px 0 8px; color:var(--primary); font-size:1em;">פרטי האם</h3>
        <div class="form-grid">
          <div class="form-group"><label>שם האם</label><input type="text" name="fam_mother_name" /></div>
          <div class="form-group"><label>ת.ז אם</label><input type="text" class="israeli-id-input" name="fam_mother_id_number" /></div>
          <div class="form-group"><label>נייד אם</label><input type="tel" name="fam_mother_mobile" /></div>
          <div class="form-group"><label>מייל אם</label><input type="email" name="fam_mother_email" /></div>
          <div class="form-group"><label>מקום עבודה אם</label><input type="text" name="fam_mother_workplace" /></div>
          <div class="form-group"><label>טל' עבודה אם</label><input type="tel" name="fam_mother_work_phone" /></div>
        </div>

        <h3 style="margin:14px 0 8px; color:var(--primary); font-size:1em;">כתובת וקשר</h3>
        <div class="form-grid">
          <div class="form-group"><label>טלפון בית</label><input type="tel" name="fam_home_phone" /></div>
          <div class="form-group"><label>רחוב</label><input type="text" name="fam_street" /></div>
          <div class="form-group"><label>מספר</label><input type="text" name="fam_house_number" /></div>
          <div class="form-group"><label>דירה</label><input type="text" name="fam_apartment" /></div>
          <div class="form-group"><label>עיר</label><input type="text" name="fam_city" value="<%= typeof student !== 'undefined' && student.fam_city ? student.fam_city : 'בני ברק' %>" /></div>
          <div class="form-group"><label>מיקוד</label><input type="text" name="fam_zip_code" /></div>
          <div class="form-group full"><label>הערות</label><textarea name="fam_notes" rows="2"></textarea></div>
        </div>

        <h3 style="margin:14px 0 8px; color:var(--primary); font-size:1em;">סבים וסבתות</h3>
        <div class="form-grid">
          <div class="form-group"><label>הורי האב (סב וסבתא)</label><input type="text" name="fam_paternal_grandparents" placeholder="שם הסב והסבתא מצד האב" /></div>
          <div class="form-group"><label>כתובת הורי האב</label><input type="text" name="fam_paternal_grandparents_address" /></div>
          <div class="form-group"><label>הורי האם (סב וסבתא)</label><input type="text" name="fam_maternal_grandparents" placeholder="שם הסב והסבתא מצד האם" /></div>
          <div class="form-group"><label>כתובת הורי האם</label><input type="text" name="fam_maternal_grandparents_address" /></div>
        </div>

      </div>
    </fieldset>

    <div class="actions">
      <button type="submit" class="btn">שמירה</button>
      <a href="<%= mode === 'new' ? '/students' : '/students/' + student.id %>" class="btn secondary">ביטול</a>
    </div>
  </form>
</div>

<script src="/js/id-validator.js"></script>
<script>
  // סנכרון מגזר ממשפחה קיימת
  function syncSectorFromFamily() {
    const famSel = document.getElementById('family_id_select');
    const sectorSel = document.getElementById('sector_select');
    if (!famSel || !sectorSel) return;
    const opt = famSel.options[famSel.selectedIndex];
    const sector = opt ? opt.getAttribute('data-sector') : '';
    if (sector) sectorSel.value = sector;
  }

  // החלפה בין משפחה קיימת/חדשה
  const radios = document.querySelectorAll('input[name="family_mode"]');
  const secExisting = document.getElementById('section-existing');
  const secNew = document.getElementById('section-new-family');

  function toggleFamilyMode() {
    const mode = document.querySelector('input[name="family_mode"]:checked')?.value;
    if (secExisting) secExisting.style.display = mode === 'existing' ? '' : 'none';
    if (secNew) secNew.style.display = mode === 'new' ? '' : 'none';
  }

  radios.forEach(r => r.addEventListener('change', toggleFamilyMode));
  toggleFamilyMode();

  // זיהוי אוטומטי של המחזור לפי תאריך לידה שהוזן
  const birthDateInput = document.getElementById('birth_date_civil_input');
  const cohortSelect = document.getElementById('cohort_id_select');
  const cohortHint = document.getElementById('cohort_auto_hint');
  if (birthDateInput && cohortSelect) {
    birthDateInput.addEventListener('change', () => {
      const date = birthDateInput.value;
      if (!date) return;
      fetch('/students/api/cohort-for-date?date=' + encodeURIComponent(date))
        .then(r => r.json())
        .then(data => {
          if (data.cohort) {
            cohortSelect.value = data.cohort.id;
            cohortHint.textContent = '✓ זוהה אוטומטית: ' + data.cohort.name;
            cohortHint.style.display = 'block';
          } else {
            cohortHint.textContent = 'לא נמצא מחזור מתאים לתאריך זה - יש לבחור ידנית';
            cohortHint.style.color = '#8a6d00';
            cohortHint.style.display = 'block';
          }
        })
        .catch(() => { /* לא קריטי - פשוט לא יזוהה אוטומטית */ });
    });
  }
</script>

<%- include('../partials/footer') %>
