<%- include('../partials/header', {title: 'שיוך ידני — כל הכיתות'}) %>

<div class="card">
  <h1>🔗 שיוך ידני — סריקה מעורבת</h1>

  <div style="background:#fff8e6; border:1px solid #e0c880; border-radius:8px; padding:11px 15px; margin-bottom:14px; font-size:0.9em; line-height:1.7;">
    <strong>מסך חד-פעמי לטפסים שהודפסו ללא קוד זיהוי.</strong>
    אפשר להעלות כאן סריקה שמכילה <strong>כמה כיתות יחד ובכל סדר</strong> —
    אין צורך למיין מראש. לכל טופס מוצג ראש העמוד, שעליו מודפסים שם התלמיד
    והכיתה, ומקלידים שם משפחה. <strong>הכיתה נגזרת מהתלמיד</strong>, וכל טופס
    נכנס לכיתה שלו ולתיק האישי שלו אוטומטית.
  </div>

  <div id="manual-all"
       data-year="<%= year %>">

    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:8px;">
      <input type="file" id="ma-file" accept="application/pdf" />
      <button type="button" id="ma-load" class="btn">📂 טעינת הסריקה</button>
      <button type="button" id="ma-send" class="btn" disabled>📤 שליחת הטפסים</button>
      <span id="ma-counter" style="color:var(--muted); font-size:0.9em;"></span>
    </div>
    <p style="font-size:0.82em; color:var(--muted); margin:0 0 8px; line-height:1.7;">
      <%= pending %> תלמידים עדיין ללא טופס לשנה זו. תלמיד שכבר יש לו טופס מסומן ב-✓.<br>
      <strong>הקלד את הטופס הראשון בלבד</strong> — משם המערכת משלימה את השאר
      לפי סדר ההדפסה של אותה כיתה. שורה שהושלמה אוטומטית מסומנת במסגרת מקווקוות;
      אם תלמיד לא החזיר, הסדר יזוז ותיקון שורה אחת מסדר את כל מה שאחריה.
    </p>
    <div id="ma-status" class="ma-status"></div>
    <div id="ma-list"></div>
  </div>

  <%# רשימת ההשלמה. datalist ולא select: 837 תלמידים ברשימה נפתחת אינם שמישים,
      וכאן מקלידים שתי אותיות והרשימה מצטמצמת. %>
  <%# הנתונים בבלוק JSON ולא במאפיין: שמות הכיתות מכילים גרש (מכינה א')
      שסוגר מאפיין העטוף בגרשיים, וה-JSON נשבר. json_encode בתוך script
      בטוח, ובלבד שנחליף רצף סוגר-תג אם יופיע בטקסט. %>
  <script type="application/json" id="ma-students-data">
    <%- JSON.stringify(students.map(s => ({
      id: s.id,
      // cls מאפשר השלמה אוטומטית: משויך טופס אחד -> הכיתה ידועה ->
      // שאר השורות מתמלאות לפי סדר ההדפסה של אותה כיתה
      cls: (s.class_name || "") + " " + (s.parallel || ""),
      label: (s.family_name || "") + " " + (s.nickname || s.first_name || "") +
             " — " + (s.class_name || "") + " " + (s.parallel || "") +
             (s.has_form ? " ✓" : "")
    }))).replace(/</g, "\\u003c") %>
  </script>

  <%# השדות שהודפסו ריקים לכל תלמיד. מולם נבדק הדיו: דיו בשדה שהודפס
      ריק פירושו שההורים כתבו בו. %>
  <script type="application/json" id="ma-empty-data">
    <%- JSON.stringify(emptyMap).replace(/</g, "\\u003c") %>
  </script>

  <%# השדות שהודפסו ריקים לכל תלמיד. מולם נבדק הדיו בסריקה: דיו בשדה
      שהודפס ריק פירושו שההורים כתבו בו. %>
  <script type="application/json" id="ma-empty-data">
    <%- JSON.stringify(emptyMap).replace(/</g, "\\u003c") %>
  </script>

  <datalist id="ma-students">
    <% students.forEach(s => { %>
      <option value="<%= (s.family_name || '') + ' ' + (s.nickname || s.first_name || '') + ' — ' + (s.class_name || '') + ' ' + (s.parallel || '') + (s.has_form ? ' ✓' : '') %>"></option>
    <% }) %>
  </datalist>

  <div class="actions" style="margin-top:16px;">
    <a href="/scans" class="btn secondary">חזרה להצהרות בריאות</a>
  </div>
</div>

<style>
  .ma-status { font-size:0.9em; margin:6px 0; min-height:1.2em; }
  .ma-status.ok { color:#2d7a4f; }
  .ma-status.err { color:#c0392b; font-weight:600; }
  /* הפס צר וארוך, ולכן הוא מקבל את מלוא הרוחב ושדה ההקלדה יורד מתחתיו.
     בפריסה של זה-לצד-זה התמונה נדחסה לחצי רוחב ולא ניתן היה לקרוא. */
  .ma-row { display:block; padding:12px 0; border-bottom:1px solid rgba(0,0,0,0.08); }
  .ma-thumb { width:100%; }
  .ma-canvas { width:100%; border:1px solid rgba(0,0,0,0.2); border-radius:6px; cursor:zoom-in; display:block; background:#fff; }
  .ma-side { display:flex; align-items:center; gap:10px; margin-top:8px; }
  .ma-side .ma-label { margin:0; white-space:nowrap; }
  .ma-label { font-size:0.85em; color:var(--muted); margin-bottom:5px; }
  .ma-warn { color:#c0392b; font-weight:600; }
  .ma-input { width:100%; font-size:1em; padding:7px; }
  .ma-input.ma-ok { border:2px solid #2d7a4f; background:#f2faf5; }
  /* שורה שהושלמה אוטומטית - גוון שונה, כדי שיהיה ברור מה אושר ידנית
     ומה המערכת הציעה ועדיין כדאי לוודא */
  .ma-input.ma-auto { border-style:dashed; background:#f7fbf9; }
  .ma-input.ma-dupe { border:2px solid #c0392b; background:#fdecea; }
  @media (max-width: 800px) {
    .ma-row { flex-direction:column; }
    .ma-side { flex:1 1 auto; width:100%; }
  }
</style>

<script src="/js/scan-fields.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
<script src="/js/vendor/pdf-lib.min.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
<script type="module" src="/js/scan-manual-all.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>

<%- include('../partials/footer') %>
