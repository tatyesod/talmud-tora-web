<%- include('../partials/header', {title: 'טופס סרוק'}) %>

<div class="card">
  <div class="sv-head">
    <div>
      <h1 style="margin:0;">
        📄 <%= form.family_name || '' %> <%= form.nickname || form.first_name || '' %>
      </h1>
      <div style="color:var(--muted); font-size:0.88em; margin-top:3px;">
        <%= form.class_name || '' %> <%= form.parallel || '' %>
        &nbsp;·&nbsp; שנה <%= form.year %>
        <% if (uploaded_str) { %>&nbsp;·&nbsp; נקלט <%= uploaded_str %><% } %>
        <% if (size_str) { %>&nbsp;·&nbsp; <%= size_str %><% } %>
        <% if (form.page_count && form.page_count < 2) { %>
          &nbsp;·&nbsp;<span style="color:#c0392b; font-weight:700;">עמוד אחד בלבד</span>
        <% } %>
      </div>
    </div>
    <div class="sv-actions">
      <%# ההדפסה על תמונות העמודים בלבד, לא על העמוד - אחרת מודפס גם התפריט %>
      <button type="button" class="btn" onclick="printForm()">🖨️ הדפסה</button>
      <a href="/scans/file/<%= form.id %>" download class="btn secondary">📥 הורדה</a>
      <a href="/scans/file/<%= form.id %>" target="_blank" rel="noopener" class="btn secondary">פתיחה בלשונית</a>
      <a href="<%= back %>" class="btn secondary">חזרה</a>
    </div>
  </div>

  <%# הטופס מצויר על ידינו ולא על ידי מציג ה-PDF של הדפדפן. הסיבה: כשההגדרה
      "הורד קבצי PDF במקום לפתוח אותם" פעילה, מסגרת מוטמעת מציגה סמל וכפתור
      במקום את המסמך. ציור עצמי אינו תלוי בהגדרה הזו. %>
  <div id="sv-status" class="sv-status">טוען…</div>
  <div id="sv-render" data-url="/scans/file/<%= form.id %>"></div>
</div>

<style>
  .sv-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
  .sv-actions { display:flex; gap:8px; flex-wrap:wrap; }
  #sv-render { max-height:78vh; overflow-y:auto; background:#f0f0f0; border:1px solid rgba(0,0,0,0.18); border-radius:8px; padding:8px; }
  .sv-page { width:100%; display:block; margin-bottom:10px; background:#fff; box-shadow:0 1px 4px rgba(0,0,0,0.2); }
  .sv-page:last-child { margin-bottom:0; }
  .sv-status { font-size:0.86em; color:var(--muted); margin-bottom:6px; min-height:1.2em; }
  .sv-status.ok { color:#2d7a4f; }
  .sv-status.err { color:#c0392b; font-weight:600; }
  @media (max-width: 700px) { #sv-render { max-height:65vh; } }
</style>

<script type="module" src="/js/scan-view.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>

<%- include('../partials/footer') %>
