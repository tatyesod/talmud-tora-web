<%- include('../partials/header', {title: 'טופס סרוק'}) %>

<div class="card">
  <div class="sv-head">
    <div>
      <h1 style="margin:0;">
        📄 <%= form.family_name || '' %> <%= form.nickname || form.first_name || '' %>
      </h1>
      <div style="color:var(--muted); font-size:0.88em; margin-top:3px;">
        <%= form.class_name || '' %> <%= form.parallel || '' %>
        &nbsp;·&nbsp; שנה <%= form.year %>
        <% if (uploaded_str) { %>&nbsp;·&nbsp; נקלט <%= uploaded_str %><% } %>
        <% if (size_str) { %>&nbsp;·&nbsp; <%= size_str %><% } %>
        <% if (form.page_count && form.page_count < 2) { %>
          &nbsp;·&nbsp;<span style="color:#c0392b; font-weight:700;">עמוד אחד בלבד</span>
        <% } %>
      </div>
    </div>
    <div class="sv-actions">
      <%# ההדפסה על ה-iframe עצמו, ולא על העמוד - אחרת מודפס גם התפריט %>
      <button type="button" class="btn" onclick="printForm()">🖨️ הדפסה</button>
      <a href="/scans/file/<%= form.id %>" download class="btn secondary">📥 הורדה</a>
      <a href="/scans/file/<%= form.id %>" target="_blank" rel="noopener" class="btn secondary">פתיחה בלשונית</a>
      <a href="<%= back %>" class="btn secondary">חזרה</a>
    </div>
  </div>

  <%# הצגת ה-PDF בתוך העמוד. #toolbar=0 מסתיר את סרגל הדפדפן, כי כפתורי
      הפעולה כבר למעלה ואין צורך בשני סרגלים. %>
  <iframe id="sv-frame" src="/scans/file/<%= form.id %>#toolbar=0&navpanes=0&view=FitH"
          title="הטופס הסרוק"></iframe>

  <p style="color:var(--muted); font-size:0.82em; margin-top:8px;">
    אם התצוגה אינה נטענת — יש דפדפנים שאינם מציגים PDF בתוך עמוד.
    השתמש ב"פתיחה בלשונית".
  </p>
</div>

<style>
  .sv-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
  .sv-actions { display:flex; gap:8px; flex-wrap:wrap; }
  #sv-frame { width:100%; height:78vh; min-height:520px; border:1px solid rgba(0,0,0,0.18); border-radius:8px; background:#fff; }
  @media (max-width: 700px) { #sv-frame { height:65vh; } }
</style>

<script>
  function printForm() {
    var f = document.getElementById("sv-frame");
    try {
      // הדפסת התוכן של המסגרת בלבד
      f.contentWindow.focus();
      f.contentWindow.print();
    } catch (e) {
      // דפדפן שחוסם גישה למסגרת - נופלים לפתיחה בלשונית ומשם מדפיסים
      window.open("/scans/file/<%= form.id %>", "_blank");
    }
  }
</script>

<%- include('../partials/footer') %>
