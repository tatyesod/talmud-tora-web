<%- include('../partials/header', {title: mode === 'new' ? 'מחזור חדש' : 'עריכת מחזור'}) %>

<div class="card">
  <h1><%= mode === 'new' ? 'הוספת מחזור חדש' : 'עריכת מחזור' %></h1>
  <% if (typeof conflict !== 'undefined' && conflict) { %>
    <div style="background:#fdecea; border:1px solid #f5c6cb; color:#a94442; border-radius:8px; padding:10px 16px; margin-bottom:14px;">
      ⚠️ מישהו אחר עדכן את המחזור הזה בינתיים. הנתונים המוצגים כאן הם המעודכנים ביותר — יש לבדוק ולבצע שוב את השינוי לפני שמירה חוזרת.
    </div>
  <% } %>
  <p style="color:var(--muted); font-size:0.9em;">
    "מחזור" קובע טווח תאריכי לידה (לפי לוח עברי) שמשייך תלמיד למחזור מסוים בעת הרישום.
    כברירת מחדל המחזורים נקבעו מא' ניסן עד כ"ט אדר של השנה שלאחר מכן — ניתן לשנות כל
    מחזור בנפרד לטווח אחר לפי הצורך.
  </p>
  <form method="POST" action="<%= mode === 'new' ? '/classes/cohorts' : '/classes/cohorts/' + cohort.id + '?_method=PUT' %>">
    <% if (mode === 'edit') { %><input type="hidden" name="updated_at" value="<%= cohort.updated_at || '' %>" /><% } %>
    <div class="form-grid">
      <div class="form-group">
        <label>שם המחזור</label>
        <div style="display:flex; gap:6px; align-items:center;">
          <input type="text" name="name" value="<%= cohort.name || '' %>" required style="flex:1;" />
          <% if (mode === 'edit') { %>
            <select onchange="if(this.value) window.location.href = '/classes/cohorts/' + this.value + '/edit';" title="עבור למחזור אחר" style="width:auto;">
              <option value="">↕️ עבור למחזור אחר...</option>
              <% allCohorts.forEach(c => { %>
                <option value="<%= c.id %>" <%= String(c.id) === String(cohort.id) ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          <% } %>
        </div>
      </div>
      <div class="form-group">
        <label>סטטוס</label>
        <select name="status">
          <option value="פעיל" <%= cohort.status === 'פעיל' ? 'selected' : '' %>>פעיל</option>
          <option value="לא פעיל" <%= cohort.status === 'לא פעיל' ? 'selected' : '' %>>לא פעיל</option>
          <option value="ארכיון" <%= cohort.status === 'ארכיון' ? 'selected' : '' %>>ארכיון</option>
        </select>
      </div>
    </div>

    <h3 style="margin-top:20px;">תחילת טווח לידה (ברירת מחדל: א' ניסן)</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>יום</label>
        <select name="start_day">
          <% dayOptions.forEach(d => { %>
            <option value="<%= d.value %>" <%= Number(cohort.start_day) === d.value ? 'selected' : '' %>><%= d.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>חודש</label>
        <select name="start_month" id="start_month_select" data-current="<%= cohort.start_month %>"></select>
      </div>
      <div class="form-group">
        <label>שנה עברית</label>
        <select name="start_year" id="start_year_select" onchange="updateMonthOptions('start_year_select','start_month_select')">
          <% yearOptions.forEach(y => { %>
            <option value="<%= y.value %>" <%= Number(cohort.start_year) === y.value ? 'selected' : '' %>><%= y.label %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <h3 style="margin-top:20px;">סוף טווח לידה (ברירת מחדל: כ"ט אדר, שנה אחרי)</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>יום</label>
        <select name="end_day">
          <% dayOptions.forEach(d => { %>
            <option value="<%= d.value %>" <%= Number(cohort.end_day) === d.value ? 'selected' : '' %>><%= d.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>חודש</label>
        <select name="end_month" id="end_month_select" data-current="<%= cohort.end_month %>"></select>
      </div>
      <div class="form-group">
        <label>שנה עברית</label>
        <select name="end_year" id="end_year_select" onchange="updateMonthOptions('end_year_select','end_month_select')">
          <% yearOptions.forEach(y => { %>
            <option value="<%= y.value %>" <%= Number(cohort.end_year) === y.value ? 'selected' : '' %>><%= y.label %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="actions" style="margin-top:14px;">
      <button type="submit" class="btn">שמירה</button>
      <a href="/classes" class="btn secondary">ביטול</a>
    </div>
  </form>
  <% if (mode === 'edit') { %>
    <form method="POST" action="/classes/cohorts/<%= cohort.id %>?_method=DELETE" onsubmit="return confirm('האם למחוק את המחזור?');" style="margin-top:10px;">
      <button type="submit" class="btn danger">מחיקת מחזור</button>
    </form>
  <% } %>
</div>

<script>
  const YEAR_LEAP_MAP = <%- JSON.stringify(Object.fromEntries(yearOptions.map(y => [y.value, y.isLeap]))) %>;

  const MONTHS_COMMON = [
    {v:7, n:"תשרי"}, {v:8, n:"חשון"}, {v:9, n:"כסלו"}, {v:10, n:"טבת"}, {v:11, n:"שבט"},
    {v:1, n:"ניסן"}, {v:2, n:"אייר"}, {v:3, n:"סיון"}, {v:4, n:"תמוז"}, {v:5, n:"אב"}, {v:6, n:"אלול"},
  ];

  function monthsForYear(isLeap) {
    // בשנה מעוברת יש גם אדר א' וגם אדר ב' (13 חודשים); בשנה רגילה יש רק
    // "אדר" אחד (12) - "אדר ב'" לא קיים בכלל ולא אמור להיות ניתן לבחירה
    const adar = isLeap
      ? [{v:12, n:"אדר א'"}, {v:13, n:"אדר ב'"}]
      : [{v:12, n:"אדר"}];
    // סדר כרונולוגי מתשרי: תשרי..שבט, אדר(ים), ניסן..אלול
    return [...MONTHS_COMMON.slice(0, 5), ...adar, ...MONTHS_COMMON.slice(5)];
  }

  function updateMonthOptions(yearSelectId, monthSelectId) {
    const yearSelect = document.getElementById(yearSelectId);
    const monthSelect = document.getElementById(monthSelectId);
    const isLeap = !!YEAR_LEAP_MAP[yearSelect.value];
    // בפעם הראשונה (טעינת הדף) שומרים על הערך שכבר נשמר לכיתה; אח"כ - על
    // מה שהמשתמש בחר לפני שינוי השנה
    const desired = monthSelect.options.length > 0 ? monthSelect.value : monthSelect.getAttribute("data-current");
    const months = monthsForYear(isLeap);
    monthSelect.innerHTML = "";
    months.forEach((m) => {
      const opt = document.createElement("option");
      opt.value = m.v;
      opt.textContent = m.n;
      if (String(m.v) === String(desired)) opt.selected = true;
      monthSelect.appendChild(opt);
    });
    // אם הערך שהיה שמור (למשל אדר ב') כבר לא קיים באפשרויות (השנה כבר לא
    // מעוברת) - לא נשארים עם שום דבר נבחר; ברירת מחדל סבירה: אדר (12)
    if (!months.some((m) => String(m.v) === String(desired))) {
      monthSelect.value = "12";
    }
  }

  updateMonthOptions("start_year_select", "start_month_select");
  updateMonthOptions("end_year_select", "end_month_select");
</script>

<%- include('../partials/footer') %>
