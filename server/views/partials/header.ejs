<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'תלמוד תורה' %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/images/icon-192.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#0d1b2e" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="ת&quot;ת החדש" />
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" />
  <script src="/js/auto-filter.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>
  <script src="/js/phone-link.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>
  <script src="/js/presence.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>
</head>
<body>
  <header class="topbar">
    <%# הלוגו מקשר לדף הבית של המשתמש ולא ל-"/" קבוע: לתחזוקן דף הבית חסום,
        ולחיצה על הלוגו הייתה מחזירה אותו לאחור בלי הסבר. %>
    <div class="brand"><a href="<%= typeof canAccess === 'function' && canAccess('/') ? '/' : '/inventory/maintenance' %>" style="color:#fff; display:flex; align-items:center; gap:10px;"><img src="/images/logo.png" alt="לוגו" style="height:40px; width:auto;" /> תלמוד תורה החדש</a></div>
    <%# לתחזוקן החיצוני אין גישה לאף מודול חוץ מבקשות התחזוקה, ולכן תפריט
        עם עשרים כרטיסיות חסומות רק מבלבל ומזמין לחיצות שיחזירו אותו לאחור.
        מקבל תפריט משלו עם מה שרלוונטי לו בלבד. %>
    <% if (typeof isMaintenanceUser !== 'undefined' && isMaintenanceUser) { %>
      <nav class="nav-maintenance">
        <a href="/inventory/maintenance" class="nav-current">🔧 בקשות תחזוקה</a>
        <% if (user) { %>
          <span class="nav-who">👤 <%= user %></span>
          <form action="/logout" method="POST" style="display:inline">
            <button type="submit" class="btn small secondary">יציאה</button>
          </form>
        <% } %>
      </nav>
    <% } else { %>
    <nav>
      <% if (canAccess("/")) { %><a href="/">בית</a><% } %>
      <% if (canAccess("/students")) { %><a href="/students">תלמידים</a><% } %>
      <% if (canAccess("/classes")) { %><a href="/classes">כיתות ומחזורים</a><% } %>
      <% if (canAccess("/letters")) { %><a href="/letters">מכתבי שיבוץ</a><% } %>
      <% if (canAccess("/teachers")) { %><a href="/teachers">מלמדים</a><% } %>
      <% if (canAccess("/families")) { %><a href="/families">משפחות</a><% } %>
      <% if (canAccess("/tuition")) { %><a href="/tuition">שכר לימוד</a><% } %>
      <% if (canAccess("/suppliers")) { %><a href="/suppliers">ספקים והזמנות</a><% } %>
      <% if (canAccess("/expenses")) { %><a href="/expenses">הוצאות</a><% } %>
      <% if (canAccess("/events")) { %><a href="/events">אירועים</a><% } %>
      <% if (canAccess("/campaigns")) { %><a href="/campaigns">מבצעים כיתתיים</a><% } %>
      <% if (canAccess("/inventory")) { %><a href="/inventory">מלאי ותחזוקה</a><% } %>
      <% if (canAccess("/parent-comm")) { %><a href="/parent-comm">תקשורת הורים</a><% } %>
      <% if (canAccess("/books")) { %><a href="/books">הזמנת ספרים</a><% } %>
      <% if (canAccess("/reports")) { %><a href="/reports">דוחות</a><% } %>
      <% if (canAccess("/scans")) { %><a href="/scans">הצהרת בריאות</a><% } %>
      <% if (canAccess("/year")) { %><a href="/year">ניהול שנה</a><% } %>
      <% if (canAccess("/messages")) { %><a href="/messages">הודעות</a><% } %>
      <% if (isAdmin) { %><% if (canAccess("/users")) { %><a href="/users">משתמשים</a><% } %><% } %>
      <a href="/profile">הפרופיל שלי</a>
      <% if (user) { %>
        <a href="/profile" style="margin-inline-start:16px; font-size:0.9em; color:var(--text);">👤 <%= user %></a>
        <form action="/logout" method="POST" style="display:inline">
          <button type="submit" class="btn small secondary" style="margin-inline-start:8px;">יציאה</button>
        </form>
      <% } %>
    </nav>
    <% } %>
  </header>
  <style>
    /* תפריט התחזוקן: פריט אחד גדול וברור, ולידו שמו והיציאה */
    nav.nav-maintenance { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    nav.nav-maintenance .nav-current {
      font-size: 1.1em; font-weight: 700; background: rgba(255,255,255,0.14);
      border-radius: 8px; padding: 7px 16px; color: #fff;
    }
    nav.nav-maintenance .nav-who { margin-inline-start: auto; font-size: 0.9em; opacity: 0.85; }
    nav.nav-maintenance .nav-small { font-size: 0.85em; opacity: 0.85; }
  </style>
  <div class="container <%= typeof wide !== 'undefined' && wide ? 'container-wide' : '' %>">
