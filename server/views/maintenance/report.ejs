<%- include('../partials/header', {title: 'דיווח תקלת תחזוקה'}) %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <h1>🛠️ דיווח תקלת תחזוקה</h1>
    <a href="/maintenance" class="btn secondary">📋 יומן דיווחים קודמים</a>
  </div>

  <p style="color:var(--muted); font-size:0.9em; line-height:1.6;">
    ממלאים את פרטי התקלה - בלחיצה על "שליחה" ייפתח מייל מוכן (עם כל הפרטים) אל התחזוקן, וגם יישמר תיעוד כאן
    במערכת לצורך מעקב.
  </p>

  <% if (saved) { %>
    <div style="background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; border-radius:8px; padding:8px 14px; margin-bottom:12px;">✅ נשמר בהצלחה. אם המייל לא נפתח אוטומטית, בדקו את הגדרות הדפדפן.</div>
  <% } %>

  <% if (!maintenanceEmail) { %>
    <div style="background:#fff3e0; border:1px solid #ffcc80; color:#e65100; border-radius:8px; padding:10px 14px; margin-bottom:14px;">
      ⚠️ לא נמצאה כתובת מייל בכרטיס האישי של משה זילברשלג. אפשר להשלים את זה שם (מומלץ), או להזין כאן זמנית:
      <form method="POST" action="/maintenance/settings/email" style="display:flex; gap:8px; margin-top:8px; align-items:center;">
        <input type="email" name="maintenance_email" placeholder="כתובת מייל התחזוקן" required style="flex:1; min-width:200px;" />
        <button type="submit" class="btn small">💾 שמירה</button>
      </form>
    </div>
  <% } %>

  <form method="POST" action="/maintenance/report" id="maintenance-form">
    <div class="form-grid">
      <div class="form-group">
        <label>סניף</label>
        <select name="branch">
          <option value="">לא רלוונטי / כללי</option>
          <% branches.forEach(b => { %>
            <option value="<%= b %>"><%= b %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>מיקום מדויק</label>
        <input type="text" name="location" placeholder="לדוגמה: חדר מלמדים, כיתה ג' 2, חצר" />
      </div>
      <div class="form-group">
        <label>דחיפות</label>
        <select name="urgency">
          <option value="רגיל">רגיל</option>
          <option value="דחוף">דחוף</option>
          <option value="דחוף מאוד">דחוף מאוד</option>
        </select>
      </div>
      <div class="form-group">
        <label>שם המדווח</label>
        <input type="text" name="reporter_name" placeholder="השם שלך" />
      </div>
      <div class="form-group full">
        <label>תיאור התקלה</label>
        <textarea name="description" rows="4" required placeholder="מה בדיוק התקלה?"></textarea>
      </div>
    </div>

    <div class="actions" style="margin-top:16px;">
      <button type="submit" class="btn" <%= !maintenanceEmail ? 'disabled title="יש להגדיר קודם כתובת מייל לתחזוקן"' : '' %>>📧 שליחה לתחזוקן</button>
      <a href="/" class="btn secondary">חזרה לדף הבית</a>
    </div>
  </form>
</div>

<script>
  const MAINTENANCE_EMAIL = <%- JSON.stringify(maintenanceEmail) %>;

  document.getElementById('maintenance-form').addEventListener('submit', function (e) {
    if (!MAINTENANCE_EMAIL) return; // אין כתובת מייל מוגדרת - רק שומר, בלי לפתוח מייל

    const branch = this.branch.value;
    const location = this.location.value.trim();
    const urgency = this.urgency.value;
    const reporter = this.reporter_name.value.trim();
    const description = this.description.value.trim();

    const subject = 'תקלת תחזוקה' + (branch ? ' - ' + branch : '') + (urgency === 'רגיל' ? '' : ' [' + urgency + ']');
    const bodyLines = [
      location ? 'מיקום: ' + location : '',
      'דחיפות: ' + urgency,
      reporter ? 'דיווח מאת: ' + reporter : '',
      '',
      description,
    ].filter(Boolean);
    const body = bodyLines.join('\n');

    const mailtoUrl = 'mailto:' + encodeURIComponent(MAINTENANCE_EMAIL) +
      '?subject=' + encodeURIComponent(subject) +
      '&body=' + encodeURIComponent(body);

    // פותחים את המייל תוך כדי אירוע הלחיצה של המשתמש (לא אחרי redirect),
    // כדי שהדפדפן לא יחסום את זה כפופ-אפ. הטופס ממשיך להישלח כרגיל לשמירה.
    window.location.href = mailtoUrl;
  });
</script>

<%- include('../partials/footer') %>
