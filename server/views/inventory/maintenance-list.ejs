<%- include('../partials/header', {title: 'בקשות תחזוקה'}) %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <h1>בקשות תחזוקה ותיקונים</h1>
    <div class="actions">
      <a href="/inventory" class="btn secondary">חזרה למלאי</a>
      <a href="/inventory/maintenance/new" class="btn">+ בקשה חדשה</a>
    </div>
  </div>
  <form class="searchbar auto-filter" method="GET" action="/inventory/maintenance">
    <select name="status">
      <option value="">כל הסטטוסים</option>
      <option value="פתוח" <%= status === 'פתוח' ? 'selected' : '' %>>פתוח</option>
      <option value="בטיפול" <%= status === 'בטיפול' ? 'selected' : '' %>>בטיפול</option>
      <option value="במעקב" <%= status === 'במעקב' ? 'selected' : '' %>>במעקב</option>
      <option value="סגור" <%= status === 'סגור' ? 'selected' : '' %>>סגור</option>
    </select>
    <select name="branch">
      <option value="">כל הסניפים</option>
      <option value="סוקולוב" <%= branch === 'סוקולוב' ? 'selected' : '' %>>סוקולוב</option>
      <option value="נפחא" <%= branch === 'נפחא' ? 'selected' : '' %>>נפחא</option>
      <option value="בן פתחיה" <%= branch === 'בן פתחיה' ? 'selected' : '' %>>בן פתחיה</option>
    </select>
  </form>

  <div class="actions" style="margin:12px 0;">
    <a href="/inventory/maintenance/print?status=<%= status %>&branch=<%= branch %>" target="_blank" class="btn secondary">
      🖨️ הדפסה <%= branch ? '- סניף ' + branch : '- כל הסניפים' %>
    </a>
    <% if (branch) { %>
      <a href="/inventory/maintenance/print?status=<%= status %>" target="_blank" class="btn secondary">🖨️ הדפסה - כל הסניפים יחד</a>
    <% } %>
    <% if (!maintenanceEmail) { %>
      <span style="color:var(--muted); font-size:0.85em;">⚠️ לא נמצא מייל תחזוקן בכרטיס האישי - שליחה חוזרת לא זמינה</span>
    <% } else { %>
      <button type="button" class="btn" onclick="resendSelected()">📧 שליחה חוזרת לתחזוקן (נבחרים)</button>
      <%# מרנדר את אותה תבנית שהתחזוקן מקבל, כדי שמה שנבדק הוא מה שהוא רואה %>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/inventory/maintenance?preview=maintenance" class="btn secondary">👁️ תצוגה כמו התחזוקן</a>
      <% } %>
    <% } %>
  </div>

  <% if (requests.length === 0) { %>
    <div class="empty-state">אין בקשות תחזוקה</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th><input type="checkbox" id="select-all" onclick="toggleAll(this)" /></th>
          <th>תאריך</th><th>סניף</th><th>תיאור</th><th>מיקום</th><th>דחיפות</th><th>דווח ע"י</th><th>סטטוס</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% let firstClosed = true; %>
        <% requests.forEach(r => { %>
          <% const place = r.class_name ? r.class_name+(r.parallel?' ('+r.parallel+')':'') : (r.location || ''); %>
          <%# הסגורות יורדות לתחתית ומופרדות בקו + כותרת, כדי שיהיו זמינות
              כהיסטוריה (תקלות חוזרות באותו מקום) בלי להפריע לעבודה השוטפת %>
          <% if (r.status === 'סגור' && firstClosed) { firstClosed = false; %>
            <tr class="closed-divider">
              <td colspan="9">היסטוריה — בקשות סגורות (אינן נכללות בהדפסה)</td>
            </tr>
          <% } %>
          <tr class="<%= r.status === 'סגור' ? 'row-closed' : '' %>">
            <td>
              <input type="checkbox" class="task-check"
                     data-description="<%= r.description %>"
                     data-branch="<%= r.effective_branch || '' %>"
                     data-place="<%= place %>"
                     data-urgency="<%= r.urgency || '' %>" />
            </td>
            <td><%= r.created_at_str %></td>
            <td><%= r.effective_branch || 'כללי' %></td>
            <td>
              <%= r.description %>
              <% if (r.updated_str) { %>
                <div style="font-size:0.78em; color:#2d7a4f; margin-top:2px;">
                  עודכן<%= r.updater_name ? ' ע"י ' + r.updater_name : '' %> · <%= r.updated_str %>
                </div>
              <% } %>
            </td>
            <td><%= place %></td>
            <td><%= r.urgency || '' %></td>
            <td><%= r.reporter_name || '' %></td>
            <td>
              <form method="POST" action="/inventory/maintenance/<%= r.id %>?_method=PUT" style="display:inline-flex; gap:4px; align-items:center;">
                <select name="status" onchange="this.form.submit()">
                  <option value="פתוח" <%= r.status === 'פתוח' ? 'selected' : '' %>>פתוח</option>
                  <option value="בטיפול" <%= r.status === 'בטיפול' ? 'selected' : '' %>>בטיפול</option>
                  <option value="במעקב" <%= r.status === 'במעקב' ? 'selected' : '' %>>במעקב</option>
                  <option value="סגור" <%= r.status === 'סגור' ? 'selected' : '' %>>סגור</option>
                </select>
                <input type="hidden" name="notes" value="<%= r.notes || '' %>" />
              </form>
            </td>
            <td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
  const MAINTENANCE_EMAIL = <%- JSON.stringify(maintenanceEmail) %>;

  function toggleAll(checkbox) {
    document.querySelectorAll('.task-check').forEach(c => c.checked = checkbox.checked);
  }

  function resendSelected() {
    const selected = [...document.querySelectorAll('.task-check:checked')];
    if (selected.length === 0) {
      alert('לא נבחרו משימות לשליחה');
      return;
    }

    // תאריך ושעה לפי שעון ישראל ובפורמט DD/MM/YYYY.
    // toLocaleDateString('he-IL') מפיק "4.3.2026" - נקודות ובלי אפס מוביל,
    // ומשתמש באזור הזמן של המכשיר במקום בשעון ישראל.
    const now = new Date();
    const ilParts = (opts) => new Intl.DateTimeFormat('en-GB',
      Object.assign({ timeZone: 'Asia/Jerusalem' }, opts))
      .formatToParts(now).reduce((a, x) => (a[x.type] = x.value, a), {});
    const dp = ilParts({ day: '2-digit', month: '2-digit', year: 'numeric' });
    const tp = ilParts({ hour: '2-digit', minute: '2-digit', hour12: false });
    const dateStr = dp.day + '/' + dp.month + '/' + dp.year;
    const timeStr = tp.hour + ':' + tp.minute;
    const subject = 'בקשת תחזוקה (שליחה חוזרת) - ' + dateStr + ' ' + timeStr;

    const bodyLines = ['רשימת תיקונים - שליחה חוזרת:', ''];
    selected.forEach((c, i) => {
      bodyLines.push((i + 1) + '. ' + c.dataset.description);
      const details = [];
      if (c.dataset.branch) details.push('סניף: ' + c.dataset.branch);
      if (c.dataset.place) details.push('מיקום: ' + c.dataset.place);
      if (c.dataset.urgency) details.push('דחיפות: ' + c.dataset.urgency);
      if (details.length) bodyLines.push('   ' + details.join(' | '));
      bodyLines.push('');
    });
    const body = bodyLines.join('\n');

    const gmailUrl = 'https://mail.google.com/mail/?view=cm&fs=1' +
      '&to=' + encodeURIComponent(MAINTENANCE_EMAIL) +
      '&su=' + encodeURIComponent(subject) +
      '&body=' + encodeURIComponent(body);
    window.open(gmailUrl, '_blank');
  }
</script>

<%- include('../partials/footer') %>

<style>
  /* בקשות סגורות - מעומעמות, כדי שהפתוחות יבלטו */
  tr.row-closed { opacity: 0.55; }
  tr.row-closed:hover { opacity: 1; }
  tr.closed-divider td {
    background: rgba(0,0,0,0.05);
    font-weight: 700;
    text-align: center;
    padding: 6px;
    border-top: 2px solid rgba(0,0,0,0.25);
  }
</style>
